---
layout: null
permalink: /news/feed.xml
translation_key: news-feed
---
{% assign articles = site.news | sort: 'date' | reverse %}
{% assign newest = articles | first %}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang | default: 'en' | escape }}">
  <title>{{ site.title | escape }} News</title>
  <subtitle>{{ site.description | normalize_whitespace | escape }}</subtitle>
  <id>{{ '/news/' | absolute_url }}</id>
  <link href="{{ '/news/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/news/' | absolute_url }}" rel="alternate" type="text/html"/>
  <updated>{{ newest.date | date_to_xmlschema }}</updated>
  {% for article in articles %}
    {% assign author = site.data.authors.items | where: 'key', article.author | first %}
    <entry>
      <title>{{ article.title | escape }}</title>
      <id>{{ article.url | absolute_url }}</id>
      <link href="{{ article.url | absolute_url }}" rel="alternate" type="text/html"/>
      <updated>{{ article.date | date_to_xmlschema }}</updated>
      <published>{{ article.date | date_to_xmlschema }}</published>
      {% if author %}<author><name>{{ author.name | escape }}</name></author>{% endif %}
      {% if article.description %}<summary type="html">{{ article.description | escape }}</summary>{% endif %}
      <content type="html">{{ article.content | markdownify | strip_html | normalize_whitespace | escape }}</content>
    </entry>
  {% endfor %}
</feed>
