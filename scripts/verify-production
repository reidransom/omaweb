#!/usr/bin/env sh
set -eu

fail() {
  printf '%s\n' "$*" >&2
  exit 1
}

count_matches() {
  grep -Eo "$2" "$1" 2>/dev/null | wc -l | tr -d ' '
}

require_output_path() {
  path=$1
  case "$path" in
    /)
      [ -f _site/index.html ]
      ;;
    */)
      [ -f "_site${path}index.html" ]
      ;;
    *)
      [ -f "_site$path" ] || [ -f "_site${path}/index.html" ]
      ;;
  esac || fail "Broken local URL in rendered output: $path"
}

require_absent_output_path() {
  path=$1
  case "$path" in
    /)
      [ ! -e _site/index.html ]
      ;;
    */)
      [ ! -e "_site${path}index.html" ] && [ ! -d "_site${path}" ]
      ;;
    *)
      [ ! -e "_site$path" ] && [ ! -e "_site${path}/index.html" ]
      ;;
  esac || fail "Removed route remains in rendered output: $path"
}

require_pinned_wte_artifact() {
  wte_path=$1
  wte_sha256=$2
  wte_bytes=$3

  for wte_file in "$wte_path" "_site/$wte_path"; do
    [ -f "$wte_file" ] || fail "Missing pinned WTE artifact: $wte_file"
    wte_actual_sha256=$(sha256sum "$wte_file" | sed 's/[[:space:]].*$//')
    [ "$wte_actual_sha256" = "$wte_sha256" ] ||
      fail "Unexpected SHA-256 for pinned WTE artifact: $wte_file"
    wte_actual_bytes=$(wc -c < "$wte_file" | tr -d ' ')
    [ "$wte_actual_bytes" -eq "$wte_bytes" ] ||
      fail "Unexpected byte size for pinned WTE artifact: $wte_file"
  done
}

require_cleared_wte_manifest_record() {
  wte_id=$1
  wte_path=$2
  wte_source_url=$3
  wte_sha256=$4
  wte_bytes=$5
  wte_record=$(sed -n "/^  - id: ${wte_id}\$/,/^  - id: /p" _data/assets.yml | sed '$d')

  [ -n "$wte_record" ] || fail "Missing WTE manifest record: $wte_id"
  printf '%s\n' "$wte_record" | grep -Fxq "    path: $wte_path" ||
    fail "WTE manifest path is invalid: $wte_id"
  printf '%s\n' "$wte_record" | grep -Fxq "    source_url: $wte_source_url" ||
    fail "WTE manifest source URL is invalid: $wte_id"
  printf '%s\n' "$wte_record" | grep -Fxq "    inspected_date: 2026-08-31" ||
    fail "WTE manifest inspection date is invalid: $wte_id"
  printf '%s\n' "$wte_record" | grep -Fxq "    sha256: $wte_sha256" ||
    fail "WTE manifest SHA-256 is invalid: $wte_id"
  printf '%s\n' "$wte_record" | grep -Fxq "    byte_size: $wte_bytes" ||
    fail "WTE manifest byte size is invalid: $wte_id"
  printf '%s\n' "$wte_record" | grep -Fxq '    rights_owner: Omacom' ||
    fail "WTE manifest rights owner is invalid: $wte_id"
  printf '%s\n' "$wte_record" | grep -Fxq '    license_or_permission: >-' ||
    fail "WTE manifest permission basis is missing: $wte_id"
  printf '%s\n' "$wte_record" | grep -Fq 'authorizes this first-party Omarchy production artifact for local publication.' ||
    fail "WTE manifest permission basis is invalid: $wte_id"
  printf '%s\n' "$wte_record" | grep -Fxq '    clearance_basis: >-' ||
    fail "WTE manifest clearance basis is missing: $wte_id"
  printf '%s\n' "$wte_record" | grep -Fq 'exact pinned first-party production artifact.' ||
    fail "WTE manifest clearance basis is invalid: $wte_id"
  printf '%s\n' "$wte_record" | grep -Fxq '    publication_status: cleared' ||
    fail "WTE manifest publication status is invalid: $wte_id"
}

[ -d _site ] || fail 'Missing _site; run Jigyll before production verification.'
[ -f _site/assets/css/site.css ] || fail 'Missing compiled CSS in _site.'
[ -f _site/assets/js/site.js ] || fail 'Missing compiled JavaScript in _site.'
[ -d _site/pagefind ] || fail 'Missing Pagefind output in _site/pagefind.'
[ -f _site/assets/images/opengraph.png ] || fail 'Missing approved local OpenGraph artwork in _site.'
[ -f _site/assets/images/favicon.png ] || fail 'Missing approved local favicon in _site.'

css_bytes=$(gzip -cn _site/assets/css/site.css | wc -c | tr -d ' ')
[ "$css_bytes" -le 40960 ] || fail "Compressed CSS budget exceeded: ${css_bytes} bytes (limit 40960)."
js_bytes=$(gzip -cn _site/assets/js/site.js | wc -c | tr -d ' ')
[ "$js_bytes" -le 61440 ] || fail "Compressed initial JavaScript budget exceeded: ${js_bytes} bytes (limit 61440)."

require_pinned_wte_artifact assets/js/wte/wte-canvas.js \
  24cdecdc6a6f0ea53e5096700b75ffcf54182197e0353952fe883b568da00e26 1390
require_pinned_wte_artifact assets/js/wte/assets/playback-C457l4sF.js \
  1f15b70870233ef238924e0318ae8b584596c58b1cba3099f41a912f5e0b9b9c 13860
require_pinned_wte_artifact assets/js/wte/ttfx.js \
  4444d2f442af28a02e1d84c3dd2daf4db5067d175f48f53f2d3c0a3078195d3e 11679
require_pinned_wte_artifact assets/js/wte/laseretch.wasm \
  0c2a7d5e614dc2158ec097b1f4bc175b21cfd6a42b13d4b10b246090a5633107 177680

require_cleared_wte_manifest_record wte-canvas-loader \
  assets/js/wte/wte-canvas.js \
  https://omarchy.org/assets/js/wte/wte-canvas.js \
  24cdecdc6a6f0ea53e5096700b75ffcf54182197e0353952fe883b568da00e26 1390
require_cleared_wte_manifest_record wte-canvas-playback \
  assets/js/wte/assets/playback-C457l4sF.js \
  https://omarchy.org/assets/js/wte/assets/playback-C457l4sF.js \
  1f15b70870233ef238924e0318ae8b584596c58b1cba3099f41a912f5e0b9b9c 13860
require_cleared_wte_manifest_record wte-ttfx-bindings \
  assets/js/wte/ttfx.js \
  https://omarchy.org/assets/js/wte/ttfx.js \
  4444d2f442af28a02e1d84c3dd2daf4db5067d175f48f53f2d3c0a3078195d3e 11679
require_cleared_wte_manifest_record wte-laseretch-effect \
  assets/js/wte/laseretch.wasm \
  https://omarchy.org/assets/js/wte/laseretch.wasm \
  0c2a7d5e614dc2158ec097b1f4bc175b21cfd6a42b13d4b10b246090a5633107 177680

grep -Fq './assets/playback-C457l4sF.js' assets/js/wte/wte-canvas.js ||
  fail 'WTE loader no longer imports its pinned local playback runtime.'
if grep -Erq 'https?://' assets/js/wte; then
  fail 'Vendored WTE runtime contains a remote runtime URL.'
fi
if grep -Fq 'data-wordmark-enhancement="laseretch"' _site/index.html; then
  grep -Eq 'data-wte-canvas-url="/[^"]*assets/js/wte/wte-canvas\.js"' _site/index.html ||
    fail 'Rendered wordmark loader URL is not a same-origin WTE path.'
  grep -Eq 'data-wte-wasm-url="/[^"]*assets/js/wte/laseretch\.wasm"' _site/index.html ||
    fail 'Rendered wordmark WASM URL is not a same-origin WTE path.'
else
  ! grep -Fq 'data-wte-' _site/index.html ||
    fail 'Laseretch-disabled output must not expose WTE runtime URLs.'
fi

required_routes='
/
/platforms/
/hardware/
/software/
/project/
/desktop/
/new-releases/
/accessories/
/community/
/workstations/
/teams/
/teams/core/
/teams/rangers/
/security/
/foundation/
/patrons/
/sponsorships/
/air/
/meetups/
/server/
/mobile/
/laptops/
/apps/
/cloud/
/labs/
/news/
/news/page/2/
/search/
/news/authors/dhh/
/news/feed.xml
/news/2026/08/omacom-foundation-launches-with-8-million/
/news/2026/09/the-omarchy-core-team/
'
printf '%s' "$required_routes" | while IFS= read -r route; do
  [ -n "$route" ] && require_output_path "$route"
done

require_absent_output_path /news/search/
obsolete_news_search_callers=$(grep -Eirn 'href="/news/search/?([?#"]|$)' _site --include='*.html' 2>/dev/null || true)
[ -z "$obsolete_news_search_callers" ] || fail 'Rendered navigation or page content still links to the removed News-only search route.'

for source in _news/*.md; do
  route=$(sed -n 's/^permalink: //p' "$source")
  [ -n "$route" ] || fail "News article has no declared permalink: $source"
  require_output_path "$route"
done

html_files=$(find _site -type f -name '*.html' ! -path '_site/pagefind/*' | sort)
[ -n "$html_files" ] || fail 'No rendered HTML files found in _site.'
titles_file=$(mktemp)
descriptions_file=$(mktemp)
canonicals_file=$(mktemp)
cleanup() {
  rm -f "$titles_file" "$descriptions_file" "$canonicals_file"
}
trap cleanup EXIT HUP INT TERM

for html in $html_files; do
  [ "$(count_matches "$html" '<title>')" -eq 1 ] || fail "Expected one title element: $html"
  [ "$(count_matches "$html" '<meta name="description"')" -eq 1 ] || fail "Expected one description meta tag: $html"
  [ "$(count_matches "$html" '<link rel="canonical"')" -eq 1 ] || fail "Expected one canonical URL: $html"
  [ "$(count_matches "$html" '<meta property="og:title"')" -eq 1 ] || fail "Expected OpenGraph title metadata: $html"
  [ "$(count_matches "$html" '<meta property="og:image"')" -eq 1 ] || fail "Expected local OpenGraph image metadata: $html"
  [ "$(count_matches "$html" '<meta name="twitter:card"')" -eq 1 ] || fail "Expected Twitter card metadata: $html"
  [ "$(count_matches "$html" '<link rel="icon"')" -eq 1 ] || fail "Expected local favicon metadata: $html"
  [ "$(count_matches "$html" '<header class="site-header"([[:space:]>])')" -eq 1 ] || fail "Expected one header landmark: $html"
  [ "$(count_matches "$html" '<main([[:space:]>])')" -eq 1 ] || fail "Expected one main landmark: $html"
  [ "$(count_matches "$html" '<footer([[:space:]>])')" -eq 1 ] || fail "Expected one footer landmark: $html"
  [ "$(count_matches "$html" '<h1([[:space:]>])')" -eq 1 ] || fail "Expected one page-level h1: $html"
  grep -Fq "frame-src https://luma.com" "$html" || fail "Missing Luma frame CSP: $html"

  sed -n 's/.*<title>\(.*\)<\/title>.*/\1/p' "$html" >> "$titles_file"
  sed -n 's/.*<meta name="description" content="\([^"]*\)".*/\1/p' "$html" >> "$descriptions_file"
  sed -n 's/.*<link rel="canonical" href="\([^"]*\)".*/\1/p' "$html" >> "$canonicals_file"

  assets=$(grep -Eo '/assets/[^"[:space:])]+' "$html" 2>/dev/null || true)
  for asset in $assets; do
    [ -f "_site$asset" ] || fail "Rendered page references a missing local asset: $asset ($html)"
  done

  links=$(grep -Eo 'href="/[^"?#]*' "$html" 2>/dev/null | sed 's/^href="//' || true)
  for link in $links; do
    require_output_path "$link"
  done
done

[ "$(sort "$titles_file" | uniq -d | wc -l | tr -d ' ')" -eq 0 ] || fail 'Rendered output contains duplicate page titles.'
[ "$(sort "$descriptions_file" | uniq -d | wc -l | tr -d ' ')" -eq 0 ] || fail 'Rendered output contains duplicate page descriptions.'
[ "$(sort "$canonicals_file" | uniq -d | wc -l | tr -d ' ')" -eq 0 ] || fail 'Rendered output contains duplicate canonical URLs.'

remote_sources=$(grep -Eirn '(src|srcset)=["'"'"']https?://' _site --include='*.html' 2>/dev/null || true)
if [ -n "$remote_sources" ]; then
  unexpected_sources=$(printf '%s\n' "$remote_sources" | grep -v 'https://luma.com/embed/calendar/' || true)
  [ -z "$unexpected_sources" ] || fail 'Rendered output contains an unexpected remote media, script, or frame URL.'
fi

if grep -Eirn 'massively|html5[[:space:]]*up|html5up[.]net|is-preload|is-mobile|is-touch' _site --include='*.html' --include='*.xml' --include='*.css' --include='*.js' >/dev/null 2>&1; then
  fail 'Clean-room scan found a prohibited reference-site identifier in rendered output.'
fi
luma_files=$(grep -rl 'https://luma.com/embed/calendar/' _site --include='*.html' 2>/dev/null || true)
iframe_files=$(grep -rl '<iframe' _site --include='*.html' 2>/dev/null || true)
[ "$iframe_files" = '_site/meetups/index.html' ] || fail 'Meetups must be the only rendered route with an iframe.'
[ "$luma_files" = '_site/meetups/index.html' ] || fail 'Luma may appear only on the rendered Meetups route.'
[ "$(grep -Eo 'https://luma.com/embed/calendar/' _site/meetups/index.html | wc -l | tr -d ' ')" -eq 1 ] ||
  fail 'Meetups must contain exactly one Luma calendar embed.'

article_count=$(find _site/news -mindepth 4 -maxdepth 4 -type f -name index.html | wc -l | tr -d ' ')
[ "$article_count" -eq 12 ] || fail "Expected 12 rendered News articles, found $article_count."
for route in /server/ /mobile/ /laptops/ /apps/ /cloud/ /labs/; do
  grep -Fq 'Exploratory' "_site${route}index.html" || fail "Exploratory label is missing: $route"
done

[ -x scripts/verify-rendered-site ] || fail 'Missing required rendered-site Chromium verifier: scripts/verify-rendered-site'
scripts/verify-rendered-site

printf '%s\n' 'Production output, route, metadata, asset, network, budget, landmark, and Chromium checks passed.'
