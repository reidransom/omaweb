#!/usr/bin/env sh
set -eu

fail() {
  printf '%s\n' "$*" >&2
  exit 1
}

require_file() {
  [ -f "$1" ] || fail "Missing required file: $1"
}

require_file _config.yml
require_file _includes/head.html
require_file _includes/seo.html
require_file assets/images/opengraph.png
require_file assets/images/favicon.png
require_file _data/project_areas.yml
require_file _data/products.yml

for product in $(awk '/^[[:space:]]+product: / { print $2 }' _data/project_areas.yml); do
  matches=$(awk -v product="$product" '$0 == "  " product ":" { count++ } END { print count + 0 }' _data/products.yml)
  [ "$matches" -eq 1 ] || fail "Project area product must resolve exactly once to a canonical product: $product"
done


grep -Fq 'social_image: /assets/images/opengraph.png' _config.yml ||
  fail 'Site configuration must use the approved local OpenGraph artwork.'
grep -Fq 'frame-src https://luma.com' _includes/head.html ||
  fail 'The CSP must restrict frames to https://luma.com.'
grep -Fq 'favicon.png' _includes/head.html ||
  fail 'The document head must reference the approved local favicon.'

content_sources="$(find accessories air apps brand cloud community desktop discord foundation hardware labs laptops manual meetups mobile new-releases news omakub patrons platforms potato project screensaver security server software sponsorships teams themes workstations _manual _news -type f \( -name '*.md' -o -name '*.html' \) | sort) index.html 404.html"
for source in $content_sources; do
  front_matter=$(awk '
    NR == 1 {
      if ($0 != "---") exit 1
      started = 1
      next
    }
    started && /^---$/ {
      ended = 1
      exit
    }
    { print }
    END {
      if (!ended) exit 1
    }
  ' "$source") || fail "Missing front matter: $source"
  printf '%s\n' "$front_matter" | grep -Eq '^title:' ||
    fail "Missing title front matter: $source"
  printf '%s\n' "$front_matter" | grep -Eq '^description:' ||
    fail "Missing description front matter: $source"
done

set -- \
  _config.yml _data _includes _layouts _manual _news _sass src assets accessories air apps brand \
  cloud community desktop discord foundation hardware labs laptops manual meetups mobile new-releases \
  news omakub patrons platforms potato project screensaver security server software sponsorships teams \
  themes workstations index.html 404.html
forbidden='massively|html5[[:space:]]*up|html5up[.]net|is-preload|is-mobile|is-touch'
if grep -Eirn "$forbidden" --include='*.html' --include='*.md' --include='*.yml' --include='*.css' --include='*.js' -- "$@" >/dev/null 2>&1; then
  fail 'Clean-room scan found a prohibited reference-site identifier in implementation source.'
fi

remote_sources=$(grep -Eirn '(src|srcset)=["'"'"']https?://' --include='*.html' --include='*.md' -- "$@" 2>/dev/null || true)
if [ -n "$remote_sources" ]; then
  unexpected_sources=$(printf '%s\n' "$remote_sources" | grep -v 'https://luma.com/embed/calendar/' || true)
  [ -z "$unexpected_sources" ] || fail 'Implementation source contains an unexpected remote media, script, or frame URL.'
fi

luma_sources=$(grep -Eirn 'https://luma.com/embed/calendar/' --include='*.html' --include='*.md' -- "$@" 2>/dev/null || true)
[ -n "$luma_sources" ] || fail 'Meetups must retain its disclosed Luma calendar fallback.'
[ "$(printf '%s\n' "$luma_sources" | wc -l | tr -d ' ')" -eq 1 ] ||
  fail 'Luma may appear only once in the implementation source.'

printf '%s\n' 'Content, asset, clean-room, and local-network checks passed.'
