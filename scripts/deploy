#!/usr/bin/env sh
set -eu

fail() {
  printf '%s\n' "$*" >&2
  exit 1
}

usage() {
  printf '%s\n' 'Usage: scripts/deploy [build|copy]'
}

require_env() {
  eval "value=\${$1-}"
  [ -n "$value" ] || fail "Missing required environment variable: $1"
}

action=${1-}
case "$action" in
  ''|build|copy) ;;
  *)
    usage >&2
    exit 2
    ;;
esac
[ "$#" -le 1 ] || {
  usage >&2
  exit 2
}

branch=$(git branch --show-current)
case "$branch" in
  rev)
    deployment_url='https://omaweb-rev.r2ware.dev'
    ;;
  main)
    deployment_url='https://omaweb.r2ware.dev'
    ;;
  *)
    fail 'Deployments are allowed only from a clean rev or main worktree.'
    ;;
esac

[ -z "$(git status --porcelain)" ] || fail 'Deployments require a clean worktree.'

require_env PAGES_PROJECT_NAME
require_env CLOUDFLARE_API_TOKEN
require_env CLOUDFLARE_ACCOUNT_ID

command -v mise >/dev/null 2>&1 || fail 'Missing required command: mise'
command -v node >/dev/null 2>&1 || fail 'Missing required command: node (used by the build toolchain)'
command -v npm >/dev/null 2>&1 || fail 'Missing required command: npm (used by the build toolchain)'
command -v npx >/dev/null 2>&1 || fail 'Missing required command: npx (used to run Wrangler)'

build_site() {
  build_config=$(mktemp)
  trap 'rm -f "$build_config"' EXIT HUP INT TERM
  printf 'url: "%s"\n' "$deployment_url" > "$build_config"

  mise install
  npm ci
  scripts/build --config "_config.yml,$build_config"
}

copy_site() {
  if [ "$branch" = rev ]; then
    npx wrangler pages deploy _site --project-name="$PAGES_PROJECT_NAME" --branch=rev
  else
    npx wrangler pages deploy _site --project-name="$PAGES_PROJECT_NAME"
  fi
}

case "$action" in
  build)
    build_site
    ;;
  copy)
    copy_site
    ;;
  '')
    build_site
    copy_site
    ;;
esac
