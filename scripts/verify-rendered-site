#!/usr/bin/env python3
"""Browser acceptance checks for the built site."""

from __future__ import annotations

import json
import sys
import urllib.parse
from pathlib import Path

from support.browser import (
    BrowserError,
    ChromiumSession,
    DevToolsSocket,
    evaluate,
    open_page,
    set_viewport,
    wait_for_complete,
)
SITE = Path("_site").resolve()
VIEWPORTS = ((390, 844), (768, 1024), (1440, 900))
ROUTES = (
    "/",
    "/desktop/",
    "/new-releases/",
    "/accessories/",
    "/search/",
    "/news/",
    "/news/2026/08/the-first-plugin-competition-winners/",
    "/news/categories/product/",
    "/workstations/",
    "/teams/",
    "/meetups/",
)
HOME_ACTION_DESTINATIONS = {
    "The Manual": "manual",
    "The ISO": "iso",
    "The Plugins": "plugins",
    "The Code": "code",
}


class VerificationError(RuntimeError):
    pass


def fail(message: str) -> None:
    raise VerificationError(message)


def wait_for(browser: DevToolsSocket, condition: str, description: str) -> None:
    matched = evaluate(
        browser,
        f"""new Promise(resolve => {{
          const deadline = performance.now() + 12000;
          const poll = () => {{
            if (Boolean({condition})) return resolve(true);
            if (performance.now() >= deadline) return resolve(false);
            requestAnimationFrame(poll);
          }};
          poll();
        }})""",
    )
    if not matched:
        fail(f"Timed out waiting for {description}.")


def press_key(
    browser: DevToolsSocket,
    key: str,
    code: str,
    key_code: int,
    modifiers: int = 0,
) -> None:
    event = {
        "key": key,
        "code": code,
        "windowsVirtualKeyCode": key_code,
        "nativeVirtualKeyCode": key_code,
        "modifiers": modifiers,
    }
    browser.command("Input.dispatchKeyEvent", {"type": "keyDown", **event})
    browser.command("Input.dispatchKeyEvent", {"type": "keyUp", **event})


def dispatch_ctrl_shortcut(browser: DevToolsSocket, key: str, code: str) -> None:
    evaluate(
        browser,
        f"""document.activeElement.dispatchEvent(new KeyboardEvent("keydown", {{
          key: {json.dumps(key)},
          code: {json.dumps(code)},
          ctrlKey: true,
          bubbles: true,
          cancelable: true
        }}))""",
    )


def click_element(browser: DevToolsSocket, selector: str) -> None:
    clicked = evaluate(
        browser,
        f"""(() => {{
          const element = document.querySelector({json.dumps(selector)});
          if (!element) return false;
          element.click();
          return true;
        }})()""",
    )
    if not clicked:
        fail(f"Missing interactive element {selector}.")


def click_at(browser: DevToolsSocket, x: float, y: float) -> None:
    for event_type in ("mousePressed", "mouseReleased"):
        browser.command(
            "Input.dispatchMouseEvent",
            {"type": event_type, "x": x, "y": y, "button": "left", "clickCount": 1},
        )


def set_search_query(browser: DevToolsSocket, selector: str, value: str) -> None:
    updated = evaluate(
        browser,
        f"""(() => {{
          const input = document.querySelector({json.dumps(selector)});
          if (!input) return false;
          input.focus();
          input.value = {json.dumps(value)};
          input.dispatchEvent(new Event("input", {{bubbles: true}}));
          return true;
        }})()""",
    )
    if not updated:
        fail(f"Missing search field {selector}.")
def canonical_destinations() -> dict[str, str]:
    destinations: dict[str, str] = {}
    slug: str | None = None
    for line in Path("_data/destinations.yml").read_text().splitlines():
        if line.startswith("  - slug: "):
            slug = line.removeprefix("  - slug: ").strip()
        elif slug and line.startswith("    url: "):
            destinations[slug] = line.removeprefix("    url: ").strip()
    return destinations


def home_actions() -> dict[str, str]:
    destinations = canonical_destinations()
    actions: dict[str, str] = {}
    for label, slug in HOME_ACTION_DESTINATIONS.items():
        url = destinations.get(slug)
        if not url:
            fail(f"Canonical destination is missing homepage action {slug}.")
        actions[label] = url
    return actions




def check_page_shell(browser: DevToolsSocket, route: str, width: int, height: int, origin: str) -> None:
    evaluate(
        browser,
        """new Promise(async resolve => {
          for (const image of document.images) {
            image.scrollIntoView({block: 'center'});
            await new Promise(done => setTimeout(done, 20));
          }
          await new Promise(done => setTimeout(done, 300));
          window.scrollTo(0, 0);
          resolve();
        })""",
    )
    metrics = evaluate(
        browser,
        """(() => ({
          headers: document.querySelectorAll('header').length,
          mains: document.querySelectorAll('main').length,
          footers: document.querySelectorAll('footer').length,
          h1s: document.querySelectorAll('h1').length,
          scrollWidth: Math.max(document.documentElement.scrollWidth, document.body.scrollWidth),
          clientWidth: document.documentElement.clientWidth,
          images: Array.from(document.images, image => ({
            src: image.currentSrc || image.src,
            complete: image.complete,
            naturalWidth: image.naturalWidth
          }))
        }))()""",
    )
    if metrics["headers"] != 1 or metrics["mains"] != 1 or metrics["footers"] != 1 or metrics["h1s"] != 1:
        fail(
            f"{route} at {width}x{height} must render one header, main, footer, and page-level h1 "
            f"(found {metrics['headers']}/{metrics['mains']}/{metrics['footers']}/{metrics['h1s']})."
        )
    if metrics["scrollWidth"] > metrics["clientWidth"] + 1:
        fail(
            f"{route} overflows horizontally at {width}x{height}: "
            f"scrollWidth {metrics['scrollWidth']} exceeds clientWidth {metrics['clientWidth']}."
        )
    for image in metrics["images"]:
        parsed = urllib.parse.urlsplit(image["src"])
        if f"{parsed.scheme}://{parsed.netloc}" != origin or not parsed.path.startswith("/assets/"):
            fail(f"{route} renders media outside the cleared local asset set: {image['src']}.")
        if not image["complete"] or image["naturalWidth"] <= 0:
            fail(f"{route} renders an unloaded or broken local image: {image['src']}.")


def check_home_actions(browser: DevToolsSocket) -> None:
    actions = evaluate(
        browser,
        """(() => Object.fromEntries(Array.from(
          document.querySelectorAll('section[aria-labelledby="actions-title"] .home-card__link'),
          link => [link.querySelector('h3')?.textContent.trim(), link.href]
        )))()""",
    )
    expected_actions = home_actions()
    if actions != expected_actions:
        fail(f"Homepage authoritative actions are incomplete or wrong: expected {expected_actions}, got {actions}.")


def check_home_scene(browser: DevToolsSocket, width: int, height: int) -> None:
    scene = evaluate(
        browser,
        """(() => {
          const picture = document.querySelector('picture.home-scene');
          const image = picture?.querySelector('img');
          return {
            count: document.querySelectorAll('picture.home-scene').length,
            position: picture && getComputedStyle(picture).position,
            currentSrc: image?.currentSrc || image?.src,
            portrait: (image?.currentSrc || image?.src || '').includes('winding-road-portrait'),
            hero: Boolean(document.querySelector('.home-hero[aria-labelledby="home-title"]')),
            expansion: Boolean(document.querySelector('.home-expansion.home-section--reveal[aria-labelledby="expansion-title"]')),
            finalCta: Boolean(document.querySelector('.home-final-cta.home-section--reveal[aria-labelledby="final-cta-title"]')),
            revealCount: document.querySelectorAll('.home-section--reveal').length
          };
        })()""",
    )
    if scene["count"] != 1 or not scene["hero"] or scene["position"] != "fixed":
        fail("Homepage must render one fixed Winding Road scene behind its opening hero.")
    if scene["portrait"] != (width < 640):
        fail(f"Homepage selects the wrong Winding Road responsive image at {width}x{height}: {scene['currentSrc']}.")
    if not scene["expansion"] or not scene["finalCta"] or scene["revealCount"] != 2:
        fail("Homepage must render the fixed scene's two intentional reveal beats: expansion and final call to action.")


def check_home_scroll_cue(browser: DevToolsSocket, width: int, height: int) -> None:
    cue = evaluate(
        browser,
        """(() => {
          const scrollRoot = document.scrollingElement;
          const scrollBehavior = scrollRoot.style.scrollBehavior;
          scrollRoot.style.scrollBehavior = 'auto';
          scrollRoot.scrollTop = 0;
          const link = document.querySelector('.home-scroll-cue');
          const rect = link?.getBoundingClientRect();
          const cue = {
            announcement: Boolean(document.querySelector('.announcement')),
            label: link?.textContent.trim().toLowerCase(),
            href: link?.getAttribute('href'),
            iconPaths: link?.querySelectorAll('svg path').length ?? 0,
            top: rect?.top,
            bottom: rect?.bottom,
            viewportHeight: window.innerHeight
          };
          scrollRoot.style.scrollBehavior = scrollBehavior;
          return cue;
        })()""",
    )
    if cue["label"] != "scroll" or cue["href"] != "#home-desktop" or cue["iconPaths"] != 1:
        fail(f"Homepage must render the labeled double-caret scroll cue; got {cue}.")
    if (
        width >= 640
        and cue["announcement"]
        and (cue["top"] < 0 or cue["bottom"] > cue["viewportHeight"])
    ):
        fail(f"Homepage scroll cue must remain in the initial viewport below an announcement at {width}x{height}; got {cue}.")


def check_header_transition(browser: DevToolsSocket) -> None:
    states = evaluate(
        browser,
        """new Promise(resolve => {
          const header = document.querySelector('.site-header');
          const sentinel = document.querySelector('[data-header-sentinel]');
          const hero = document.querySelector('.home-hero');
          const scrollRoot = document.scrollingElement;
          const waitFor = (expected, complete) => {
            const deadline = performance.now() + 2000;
            const poll = () => {
              if (header?.dataset.headerState === expected) return complete(true);
              if (performance.now() >= deadline) return complete(false);
              requestAnimationFrame(poll);
            };
            poll();
          };
          scrollRoot.scrollTo({ top: 0, behavior: 'instant' });
          window.dispatchEvent(new Event('scroll'));
          waitFor('transparent', atTop => {
            if (!atTop) return resolve([header?.dataset.headerState, 'not-transparent-at-top']);
            scrollRoot.scrollTo({
              top: scrollRoot.scrollTop + hero.getBoundingClientRect().bottom + 1,
              behavior: 'instant'
            });
            window.dispatchEvent(new Event('scroll'));
            waitFor('opaque', pastHero => resolve([
              'transparent',
              pastHero ? 'opaque' : header?.dataset.headerState
            ]));
          });
        })""",
    )
    if states != ["transparent", "opaque"]:
        fail(f"Homepage header must transition transparent-to-opaque across the hero; got {states}.")



def check_route_semantics(browser: DevToolsSocket, route: str) -> None:
    expected = {
        "/desktop/": ("Desktops", ("exploring", "desktop hardware", "recommendation")),
        "/new-releases/": ("New Releases", ("nothing to announce", "may later highlight releases")),
        "/accessories/": ("Accessories", ("no accessory recommendations", "third-party hardware")),
        "/search/": ("Search Omarchy", ("site pages", "news", "destinations")),
    }.get(route)
    if not expected:
        return

    semantics = evaluate(
        browser,
        r"""(() => ({
          title: document.title,
          heading: document.querySelector("main h1")?.textContent.trim(),
          text: document.querySelector("main")?.textContent.replace(/\s+/g, " ").trim().toLocaleLowerCase()
        }))()""",
    )
    label, terms = expected
    if semantics["heading"] != label or not semantics["title"].startswith(label):
        fail(f"{route} must expose {label!r} in its page heading and metadata; got {semantics}.")
    if any(term not in semantics["text"] for term in terms):
        fail(f"{route} no longer communicates its required observable purpose: {semantics['text']!r}.")
    if route == "/desktop/" and "current omarchy desktop environment" in semantics["text"]:
        fail("/desktop/ must not describe itself as the current Omarchy desktop environment.")


def check_navigation_inventory(browser: DevToolsSocket) -> None:
    inventory = evaluate(
        browser,
        r"""(() => {
          const label = link => {
            const copy = link.cloneNode(true);
            copy.querySelectorAll("sup, .u-visually-hidden, .site-header__shortcut").forEach(element => element.remove());
            return copy.textContent.replace(/\s+/g, " ").trim();
          };
          const panel = document.querySelector("[data-quake-fallback]");
          const groups = Object.fromEntries(Array.from(panel?.querySelectorAll("nav > section") || [], section => {
            const sectionLink = section.querySelector("h2 > a");
            return [label(sectionLink), {
              url: new URL(sectionLink.href).pathname,
              external: sectionLink.dataset.external === "true",
              children: Array.from(section.querySelectorAll("li > a"), link => ({
                label: label(link),
                url: new URL(link.href).pathname,
                external: link.dataset.external === "true",
                exploratory: Boolean(link.querySelector("sup[aria-describedby]"))
              }))
            }];
          }));
          const header = document.querySelector("header");
          const primary = Array.from(
            header?.querySelectorAll('nav[aria-label="Primary navigation"] a[href]') || [],
            link => ({label: label(link), url: new URL(link.href).pathname, visible: Boolean(link.getClientRects().length)})
          );
          const markers = Array.from(panel?.querySelectorAll("a") || [], link => {
            const marker = link.querySelector("sup[aria-describedby]");
            return marker && [label(link), document.getElementById(marker.getAttribute("aria-describedby"))?.textContent.replace(/\s+/g, " ").trim()];
          }).filter(Boolean);
          const search = header?.querySelector("[data-spotlight-open]");
          const menu = header?.querySelector("[data-quake-toggle]");
          return {
            groups,
            primary,
            markers,
            merchMarked: Boolean(Array.from(panel?.querySelectorAll("a") || []).find(link => label(link) === "Merch")?.querySelector("sup")),
            search: search && {url: new URL(search.href).pathname, text: search.textContent.replace(/\s+/g, " ").trim(), visible: Boolean(search.getClientRects().length)},
            menu: menu && {
              text: menu.textContent.replace(/\s+/g, " ").trim(),
              visible: Boolean(menu.getClientRects().length),
              controls: menu.getAttribute("aria-controls"),
              shortcut: (() => {
                const hint = menu.querySelector(".site-header__shortcut");
                return hint && {
                  text: hint.textContent.replace(/\s+/g, " ").trim(),
                  visible: Boolean(hint.getClientRects().length)
                };
              })()
            },
            prunedLinks: Array.from(document.querySelectorAll('header a[href], [data-quake-fallback] a[href]'), link => new URL(link.href).pathname)
              .filter(path => ["/platforms/", "/hardware/", "/software/", "/project/", "/server/", "/apps/", "/cloud/", "/labs/"].includes(path))
          };
        })()""",
    )
    expected_groups = {
        "Foundation": ["Patrons", "Sponsorships", "Artists in Residence", "Security"],
        "Manual": ["Download ISO", "Getting Started", "Hotkeys", "Omarchy CLI", "Troubleshooting", "FAQ"],
        "Shop": ["Laptops", "Desktops", "Mobile", "Merch", "Accessories"],
        "News": ["Product", "Releases", "Events", "Editorial", "Atom feed"],
        "Community": ["Discord", "Meetups", "Workstations", "Plugins", "Teams", "Code"],
    }
    if list(inventory["groups"]) != list(expected_groups):
        fail(f"Quake navigation must expose the five authoritative sections; got {inventory['groups']}.")
    for section, expected_children in expected_groups.items():
        children = inventory["groups"][section]["children"]
        if [child["label"] for child in children] != expected_children:
            fail(f"{section} links must retain their authoritative visible order; got {children}.")
    if inventory["groups"]["Foundation"]["url"] != "/foundation/" or inventory["groups"]["Shop"]["url"] != "/new-releases/" or inventory["groups"]["News"]["url"] != "/news/" or inventory["groups"]["Community"]["url"] != "/community/":
        fail(f"Primary section routes are wrong: {inventory['groups']}.")
    if not inventory["groups"]["Manual"]["external"] or not all(child["external"] for child in inventory["groups"]["Manual"]["children"]):
        fail("Manual and its chapters must remain authoritative external destinations.")
    shop_children = {child["label"]: child for child in inventory["groups"]["Shop"]["children"]}
    if (
        shop_children["Laptops"]["url"] != "/laptops/"
        or shop_children["Desktops"]["url"] != "/desktop/"
        or shop_children["Mobile"]["url"] != "/mobile/"
        or shop_children["Accessories"]["url"] != "/accessories/"
        or shop_children["Merch"]["external"] is not True
    ):
        fail(f"Shop routes or external Merch status are wrong: {shop_children}.")
    if {label for label, _ in inventory["markers"]} != {"Shop", "Laptops", "Desktops", "Mobile", "Accessories"} or inventory["merchMarked"]:
        fail(f"Exploratory markers must cover Shop and future hardware only; got {inventory['markers']}.")
    descriptions = {description for _, description in inventory["markers"]}
    if descriptions != {"Exploratory. These are areas Omarchy may cover, not products or release promises."}:
        fail(f"Exploratory markers must share the explanatory relationship; got {descriptions}.")
    if (
        [item["label"] for item in inventory["primary"] if item["visible"]]
        != ["Foundation", "Manual", "Shop", "News", "Community"]
        or not inventory["search"]
        or inventory["search"]["url"] != "/search/"
        or "Ctl+K" not in inventory["search"]["text"]
        or not inventory["menu"]
        or inventory["menu"]["controls"] != "quake-navigation"
        or inventory["menu"]["shortcut"] != {"text": "Ctl+`", "visible": True}
        or inventory["prunedLinks"]
    ):
        fail(f"Closed desktop header controls or curated links are wrong: {inventory}.")


def check_direct_navigation(browser: DevToolsSocket, origin: str) -> None:
    for label, route in (
        ("Foundation", "/foundation/"),
        ("Shop", "/new-releases/"),
        ("News", "/news/"),
        ("Community", "/community/"),
    ):
        browser.command("Page.navigate", {"url": origin + "/"})
        wait_for_complete(browser, "/")
        clicked = evaluate(
            browser,
            rf"""(() => {{
              const link = Array.from(document.querySelectorAll('nav[aria-label="Primary navigation"] a[href]'))
                .find(candidate => {{
                  const copy = candidate.cloneNode(true);
                  copy.querySelectorAll("sup, .u-visually-hidden").forEach(element => element.remove());
                  return copy.textContent.replace(/\s+/g, " ").trim() === {json.dumps(label)};
                }});
              if (!link) return false;
              link.click();
              return true;
            }})()""",
        )
        if not clicked:
            fail(f"Desktop header is missing the direct {label} link.")
        wait_for_complete(browser, route, f"direct {label} navigation")


def check_closed_responsive_header(browser: DevToolsSocket, width: int) -> None:
    state = evaluate(
        browser,
        r"""(() => {
          const header = document.querySelector("header");
          const visible = element => Boolean(element?.getClientRects().length) && !element.hidden;
          const label = link => {
            const copy = link.cloneNode(true);
            copy.querySelectorAll("sup, .u-visually-hidden, .site-header__shortcut").forEach(element => element.remove());
            return copy.textContent.replace(/\s+/g, " ").trim();
          };
          return {
            brand: visible(header?.querySelector('a[href="/"]')),
            primary: Array.from(header?.querySelectorAll('nav[aria-label="Primary navigation"] a') || [])
              .filter(visible).map(label),
            menu: visible(header?.querySelector("[data-quake-toggle]")),
            search: visible(header?.querySelector("[data-spotlight-open]")),
            drawer: document.querySelector("[data-drawer]")?.open === true
          };
        })()""",
    )
    expected_primary = ["Foundation", "Manual", "Shop", "News", "Community"] if width >= 1024 else []
    if not state["brand"] or state["primary"] != expected_primary or not state["menu"] or not state["search"] or state["drawer"]:
        fail(f"Closed header at {width}px has the wrong responsive navigation treatment: {state}.")


def check_current_navigation(browser: DevToolsSocket, origin: str) -> None:
    browser.command("Page.navigate", {"url": origin + "/new-releases/"})
    wait_for_complete(browser, "/new-releases/")
    current = evaluate(
        browser,
        r"""(() => Array.from(document.querySelectorAll('header a[aria-current="page"], [data-quake-fallback] a[aria-current="page"]'), link => ({
          label: link.textContent.replace(/\*/g, "").replace(/\s+/g, " ").trim(),
          path: new URL(link.href).pathname,
          currentTreatment: getComputedStyle(link).textDecorationLine === "underline"
        })))()""",
    )
    if (
        not current
        or any(
            item != {
                "label": "Shop",
                "path": "/new-releases/",
                "currentTreatment": True,
            }
            for item in current
        )
    ):
        fail(f"New Releases must expose Shop as the semantic and visible current destination in header and panel; got {current}.")
    if evaluate(browser, 'document.querySelector("header")?.dataset.headerState') != "opaque":
        fail("Non-home routes must keep the header opaque.")
    click_element(browser, "[data-quake-toggle]")
    wait_for(browser, 'document.querySelector("[data-quake-fallback]")?.open', "Quake navigation on a non-home route")
    press_key(browser, "Escape", "Escape", 27)
    wait_for(browser, '!document.querySelector("[data-quake-fallback]")?.open', "non-home Quake dismissal")
    if evaluate(browser, 'document.querySelector("header")?.dataset.headerState') != "opaque":
        fail("Closing Quake must restore the opaque header on non-home routes.")


def check_desktop_quake(browser: DevToolsSocket, origin: str) -> None:
    browser.command("Page.navigate", {"url": origin + "/"})
    wait_for_complete(browser, "/")
    hover_point = evaluate(
        browser,
        """(() => {
          const link = document.querySelector('nav[aria-label="Primary navigation"] a[href="/foundation/"]');
          const rect = link?.getBoundingClientRect();
          return rect && {x: rect.left + rect.width / 2, y: rect.top + rect.height / 2};
        })()""",
    )
    if not hover_point:
        fail("Desktop Foundation link is unavailable for the hover-disclosure check.")
    browser.command("Input.dispatchMouseEvent", {"type": "mouseMoved", **hover_point})
    no_hover = evaluate(
        browser,
        """new Promise(resolve => setTimeout(() => {
          const panel = document.querySelector("[data-quake-fallback]");
          resolve(!panel.open && panel.hidden);
        }, 250))""",
    )
    if not no_hover:
        fail("Moving across a desktop section link must not open Quake navigation.")

    evaluate(browser, 'document.querySelector("[data-quake-toggle]")?.focus()')
    press_key(browser, "Enter", "Enter", 13)
    wait_for(browser, 'document.querySelector("[data-quake-fallback]")?.open', "Enter to open Quake navigation")
    evaluate(browser, 'document.querySelector("[data-quake-toggle]")?.focus()')
    press_key(browser, " ", "Space", 32)
    wait_for(browser, '!document.querySelector("[data-quake-fallback]")?.open', "Space to close Quake navigation")
    if not evaluate(browser, 'document.activeElement === document.querySelector("[data-quake-toggle]")'):
        fail("Menu toggle dismissal must restore focus to Menu.")

    before_open = evaluate(
        browser,
        """(() => ({
          mainTop: document.querySelector("main")?.getBoundingClientRect().top,
          headerBottom: document.querySelector("header")?.getBoundingClientRect().bottom
        }))()""",
    )
    click_element(browser, "[data-quake-toggle]")
    wait_for(browser, 'document.querySelector("[data-quake-fallback]")?.dataset.quakeState === "open"', "the Quake panel to open")
    wait_for(
        browser,
        'document.querySelector("[data-quake-fallback]")?.getBoundingClientRect().top >= document.querySelector("header")?.getBoundingClientRect().bottom - 1',
        "Quake panel drop transition",
    )
    opened = evaluate(
        browser,
        """(() => {
          const panel = document.querySelector("[data-quake-fallback]");
          const header = document.querySelector("header");
          const first = panel?.querySelector("nav > section h2 > a");
          const rect = panel?.getBoundingClientRect();
          const style = panel && getComputedStyle(panel);
          return {
            open: panel?.open === true && panel.hidden === false,
            expanded: document.querySelector("[data-quake-toggle]")?.getAttribute("aria-expanded"),
            focus: document.activeElement === first,
            attached: Math.abs((rect?.top ?? 0) - header.getBoundingClientRect().bottom) <= 1,
            covers: Math.abs((document.querySelector("main")?.getBoundingClientRect().top ?? 0) - window.__quakeMainTop) <= 1,
            capped: (rect?.height ?? Infinity) <= innerHeight * 0.6 + 1,
            natural: (rect?.height ?? Infinity) < innerHeight * 0.6 - 1,
            transition: style?.transitionDuration,
            transform: style?.transform,
            scrollable: style?.overflowY === "auto" || style?.overflowY === "scroll",
            header: header.dataset.headerState
          };
        })()""".replace("window.__quakeMainTop", str(before_open["mainTop"])),
    )
    if (
        not opened["open"]
        or opened["expanded"] != "true"
        or not opened["focus"]
        or not opened["attached"]
        or not opened["covers"]
        or not opened["capped"]
        or not opened["natural"]
        or not opened["scrollable"]
        or opened["header"] != "opaque"
        or "0.15s" not in opened["transition"]
    ):
        fail(f"Quake must be a short, attached, covering non-modal panel with initial link focus; got {opened}.")
    scroll_position = evaluate(
        browser,
        """(() => {
          const scrollRoot = document.scrollingElement;
          const before = scrollRoot.scrollTop;
          const behavior = scrollRoot.style.scrollBehavior;
          scrollRoot.style.scrollBehavior = "auto";
          scrollRoot.scrollTop = before + 200;
          const after = scrollRoot.scrollTop;
          scrollRoot.style.scrollBehavior = behavior;
          return [before, after];
        })()""",
    )
    if scroll_position[1] <= scroll_position[0]:
        fail("Opening Quake navigation must not lock document scrolling.")
    press_key(browser, "Tab", "Tab", 9)
    evaluate(browser, 'document.scrollingElement.style.scrollBehavior = "auto"; document.scrollingElement.scrollTop = 0; document.scrollingElement.style.scrollBehavior = ""; window.dispatchEvent(new Event("scroll"))')
    tabbed = evaluate(
        browser,
        """(() => {
          const panel = document.querySelector("[data-quake-fallback]");
          const active = document.activeElement;
          return panel.open && active instanceof HTMLAnchorElement && new URL(active.href).pathname === "/patrons/";
        })()""",
    )
    if not tabbed:
        fail("Tab must progress from Quake's focused section link into its child links.")
    evaluate(browser, 'Array.from(document.querySelectorAll("[data-quake-fallback] nav a[href]")).at(-1)?.focus()')
    press_key(browser, "Tab", "Tab", 9)
    if not evaluate(browser, 'Boolean(document.activeElement.closest("main"))'):
        fail("Tab must continue past Quake navigation into the page rather than trapping focus.")
    press_key(browser, "Escape", "Escape", 27)
    wait_for(browser, '!document.querySelector("[data-quake-fallback]")?.open', "Escape to dismiss Quake navigation")
    escaped = evaluate(
        browser,
        """(() => ({
          focus: document.activeElement === document.querySelector("[data-quake-toggle]"),
          expanded: document.querySelector("[data-quake-toggle]")?.getAttribute("aria-expanded"),
          header: document.querySelector("header")?.dataset.headerState
        }))()""",
    )
    if escaped["focus"] is not True or escaped["expanded"] != "false" or escaped["header"] != "transparent":
        fail(f"Escape must restore focus and the homepage header state after Quake; got {escaped}.")

    click_element(browser, "[data-quake-toggle]")
    wait_for(browser, 'document.querySelector("[data-quake-fallback]")?.open', "Quake to reopen")
    outside = evaluate(
        browser,
        """(() => {
          const panel = document.querySelector("[data-quake-fallback]").getBoundingClientRect();
          return {x: Math.max(1, panel.left + 8), y: Math.min(innerHeight - 2, panel.bottom + 8)};
        })()""",
    )
    click_at(browser, outside["x"], outside["y"])
    wait_for(browser, '!document.querySelector("[data-quake-fallback]")?.open', "outside click to dismiss Quake")
    if evaluate(browser, 'document.activeElement === document.querySelector("[data-quake-toggle]")'):
        fail("Outside dismissal must not steal focus back to Menu.")


def check_short_quake(browser: DevToolsSocket, origin: str) -> None:
    browser.command("Page.navigate", {"url": origin + "/"})
    wait_for_complete(browser, "/")
    set_viewport(browser, 1440, 400)
    click_element(browser, "[data-quake-toggle]")
    wait_for(browser, 'document.querySelector("[data-quake-fallback]")?.open', "short-viewport Quake panel")
    metrics = evaluate(
        browser,
        """(() => {
          const panel = document.querySelector("[data-quake-fallback]");
          const style = getComputedStyle(panel);
          return {
            height: panel.getBoundingClientRect().height,
            max: innerHeight * 0.6,
            scrollable: panel.scrollHeight > panel.clientHeight && (style.overflowY === "auto" || style.overflowY === "scroll")
          };
        })()""",
    )
    if metrics["height"] > metrics["max"] + 1 or not metrics["scrollable"]:
        fail(f"Quake must cap and internally scroll on a short display; got {metrics}.")


def check_navigation_shortcuts(browser: DevToolsSocket, origin: str, width: int) -> None:
    browser.command("Page.navigate", {"url": origin + "/"})
    wait_for_complete(browser, "/")
    set_viewport(browser, width, 844 if width == 390 else 1024)
    press_key(browser, "`", "Backquote", 192, modifiers=2)
    if width < 768:
        wait_for(browser, 'document.querySelector("[data-drawer]")?.open', "Ctrl+` to open the mobile drawer")
        press_key(browser, "`", "Backquote", 192, modifiers=2)
        wait_for(browser, '!document.querySelector("[data-drawer]")?.open', "Ctrl+` to close the mobile drawer")
    else:
        wait_for(browser, 'document.querySelector("[data-quake-fallback]")?.open', "Ctrl+` to open Quake navigation")
        press_key(browser, "`", "Backquote", 192, modifiers=2)
        wait_for(browser, '!document.querySelector("[data-quake-fallback]")?.open', "Ctrl+` to close Quake navigation")

    dispatch_ctrl_shortcut(browser, "`", "IntlBackslash")
    if width < 768:
        wait_for(browser, 'document.querySelector("[data-drawer]")?.open', "logical Ctrl+` to open the mobile drawer")
        press_key(browser, "`", "Backquote", 192, modifiers=2)
        wait_for(browser, '!document.querySelector("[data-drawer]")?.open', "logical Ctrl+` mobile drawer cleanup")
    else:
        wait_for(browser, 'document.querySelector("[data-quake-fallback]")?.open', "logical Ctrl+` to open Quake navigation")
        press_key(browser, "`", "Backquote", 192, modifiers=2)
        wait_for(browser, '!document.querySelector("[data-quake-fallback]")?.open', "logical Ctrl+` Quake cleanup")

    dispatch_ctrl_shortcut(browser, "Dead", "Backquote")
    if width < 768:
        wait_for(browser, 'document.querySelector("[data-drawer]")?.open', "physical Ctrl+Backquote to open the mobile drawer")
        press_key(browser, "`", "Backquote", 192, modifiers=2)
        wait_for(browser, '!document.querySelector("[data-drawer]")?.open', "physical Ctrl+Backquote mobile drawer cleanup")
    else:
        wait_for(browser, 'document.querySelector("[data-quake-fallback]")?.open', "physical Ctrl+Backquote to open Quake navigation")
        press_key(browser, "`", "Backquote", 192, modifiers=2)
        wait_for(browser, '!document.querySelector("[data-quake-fallback]")?.open', "physical Ctrl+Backquote Quake cleanup")

def check_mobile_drawer(browser: DevToolsSocket) -> None:
    drawer = evaluate(
        browser,
        """new Promise(resolve => {
          const opener = document.querySelector('[data-drawer-open]');
          const dialog = document.querySelector('[data-drawer]');
          const close = dialog?.querySelector('[data-drawer-close]');
          const fallback = document.querySelector('[data-drawer-fallback]');
          opener?.click();
          requestAnimationFrame(() => {
            const opened = Boolean(
              !opener?.hidden && fallback?.hidden && dialog?.open &&
              document.activeElement === close && opener?.getAttribute('aria-expanded') === 'true'
            );
            close?.click();
            requestAnimationFrame(() => resolve({
              opened,
              closed: !dialog?.open && document.activeElement === opener && opener?.getAttribute('aria-expanded') === 'false'
            }));
          });
        })""",
    )
    if drawer != {"opened": True, "closed": True}:
        fail(f"Mobile drawer must move focus to Close and return it to Menu; got {drawer}.")


def enable_network_disable_cache_and_clear_browser_cache(browser: DevToolsSocket) -> None:
    browser.command("Network.enable")
    browser.command("Network.setCacheDisabled", {"cacheDisabled": True})
    browser.command("Network.clearBrowserCache")


def install_wordmark_observers(browser: DevToolsSocket) -> None:
    browser.command("Page.enable")
    browser.command(
        "Page.addScriptToEvaluateOnNewDocument",
        {
            "source": """(() => {
              const evidence = {
                errors: [],
                resources: []
              };
              window.__wordmarkBrowserEvidence = evidence;
              addEventListener("error", event => {
                evidence.errors.push(`error: ${event.message || event.error || "unknown"}`);
              }, true);
              addEventListener("unhandledrejection", event => {
                evidence.errors.push(`unhandledrejection: ${event.reason || "unknown"}`);
              });
              new PerformanceObserver(entries => {
                for (const entry of entries.getEntries()) evidence.resources.push(entry.name);
              }).observe({type: "resource", buffered: true});
            })()""",
        },
    )


def wordmark_pixel_samples(context: str) -> str:
    return f"""(() => {{
      const pixels = [];
      for (let y = 1; y < 12; y += 1) {{
        for (let x = 1; x < 12; x += 1) {{
          pixels.push(...{context}.getImageData(
            Math.min(canvas.width - 1, Math.floor(canvas.width * x / 12)),
            Math.min(canvas.height - 1, Math.floor(canvas.height * y / 12)),
            1,
            1
          ).data);
        }}
      }}
      return pixels;
    }})()"""


def wordmark_snapshot(browser: DevToolsSocket, include_pixels: bool = False) -> dict:
    return evaluate(
        browser,
        f"""(() => {{
          const root = document.querySelector("[data-wordmark]");
          const canvas = root?.querySelector("[data-wordmark-canvas]");
          const context = canvas?.getContext("2d");
          const fallback = root?.querySelector("[data-wordmark-fallback]");
          const rectangle = element => {{
            const rect = element.getBoundingClientRect();
            return {{left: rect.left, top: rect.top, width: rect.width, height: rect.height}};
          }};
          const style = element => {{
            const computed = getComputedStyle(element);
            return {{display: computed.display, visibility: computed.visibility, color: computed.color}};
          }};
          const probe = document.createElement("span");
          probe.style.color = "var(--omarchy-green)";
          root?.append(probe);
          const green = root ? getComputedStyle(probe).color : null;
          probe.remove();
          const pixels = {str(include_pixels).lower()} && canvas?.width && canvas?.height && context
            ? {wordmark_pixel_samples("context")}
            : [];
          return {{
            root: Boolean(root),
            state: root?.getAttribute("data-wordmark-enhanced") ?? null,
            fallback: fallback ? {{rect: rectangle(fallback), ...style(fallback)}} : null,
            canvas: canvas ? {{
              rect: rectangle(canvas),
              ...style(canvas),
              width: canvas.width,
              height: canvas.height,
              pixels
            }} : null,
            green,
            scrollWidth: Math.max(document.documentElement.scrollWidth, document.body.scrollWidth),
            clientWidth: document.documentElement.clientWidth,
            evidence: window.__wordmarkBrowserEvidence ?? null
          }};
        }})()""",
    )


def assert_static_wordmark(snapshot: dict, description: str, expected_state: str | None) -> None:
    fallback = snapshot["fallback"]
    canvas = snapshot["canvas"]
    if (
        not snapshot["root"]
        or snapshot["state"] != expected_state
        or fallback is None
        or canvas is None
        or fallback["rect"]["width"] <= 0
        or fallback["rect"]["height"] <= 0
        or fallback["display"] == "none"
        or fallback["visibility"] == "hidden"
        or fallback["color"] != snapshot["green"]
        or canvas["display"] != "none"
    ):
        fail(f"{description} must show the Green static wordmark and no Canvas output; got {snapshot}.")


def assert_matching_wordmark_bounds(snapshot: dict, description: str) -> None:
    fallback = snapshot["fallback"]
    canvas = snapshot["canvas"]
    if (
        not snapshot["root"]
        or snapshot["state"] != "true"
        or fallback is None
        or canvas is None
        or canvas["display"] == "none"
        or fallback["rect"]["width"] <= 0
        or fallback["rect"]["height"] <= 0
        or canvas["rect"]["width"] <= 0
        or canvas["rect"]["height"] <= 0
        or any(
            abs(fallback["rect"][side] - canvas["rect"][side]) > 1
            for side in ("left", "top", "width", "height")
        )
        or snapshot["scrollWidth"] > snapshot["clientWidth"] + 1
    ):
        fail(f"{description} must retain matching fallback and enhanced Canvas bounds without overflow; got {snapshot}.")


def assert_no_page_errors(snapshot: dict, description: str) -> None:
    errors = snapshot["evidence"]["errors"] if snapshot["evidence"] else []
    if errors:
        fail(f"{description} must not report uncaught errors or unhandled rejections; got {errors}.")


def sample_wordmark_playback(browser: DevToolsSocket) -> dict:
    return evaluate(
        browser,
        """new Promise(resolve => {
          const canvas = document.querySelector("[data-wordmark-canvas]");
          const context = canvas?.getContext("2d");
          if (!canvas || !context || !canvas.width || !canvas.height) {
            return resolve({changed: false, stable: false, pixels: []});
          }
          const sample = () => """ + wordmark_pixel_samples("context") + """;
          const differs = (before, after) => before.some((value, index) => value !== after[index]);
          const deadline = performance.now() + 12000;
          let previous = sample();
          let changed = false;
          let stableFrames = 0;
          const observe = () => {
            const current = sample();
            if (differs(previous, current)) {
              changed = true;
              stableFrames = 0;
            } else if (changed) {
              stableFrames += 1;
            }
            previous = current;
            if ((changed && stableFrames >= 12) || performance.now() >= deadline) {
              return resolve({changed, stable: changed && stableFrames >= 12, pixels: current});
            }
            requestAnimationFrame(observe);
          };
          requestAnimationFrame(observe);
        })""",
    )


def wait_for_animation_frames(browser: DevToolsSocket) -> None:
    evaluate(
        browser,
        """new Promise(resolve => {
          let remaining = 3;
          const frame = () => --remaining ? requestAnimationFrame(frame) : resolve();
          requestAnimationFrame(frame);
        })""",
    )

def wordmark_pixels_remain_stable(browser: DevToolsSocket) -> bool:
    before = wordmark_snapshot(browser, include_pixels=True)["canvas"]["pixels"]
    evaluate(
        browser,
        """new Promise(resolve => {
          let remaining = 24;
          const frame = () => --remaining ? requestAnimationFrame(frame) : resolve();
          requestAnimationFrame(frame);
        })""",
    )
    after = wordmark_snapshot(browser, include_pixels=True)["canvas"]["pixels"]
    return sum(abs(previous - current) for previous, current in zip(before, after)) <= 4



def check_normal_wordmark(debug_url: str, origin: str, width: int, height: int) -> None:
    browser = open_page(debug_url, origin, "/__browser-check-blank__")
    try:
        set_viewport(browser, width, height)
        install_wordmark_observers(browser)
        enable_network_disable_cache_and_clear_browser_cache(browser)
        browser.command("Page.navigate", {"url": origin + "/"})
        wait_for_complete(browser, "/", f"homepage wordmark at {width}x{height}")
        wait_for(
            browser,
            'document.querySelector("[data-wordmark]")?.dataset.wordmarkEnhanced === "true"',
            f"enhanced wordmark at {width}x{height}",
        )
        snapshot = wordmark_snapshot(browser)
        assert_matching_wordmark_bounds(snapshot, f"Wordmark at {width}x{height}")
        playback = sample_wordmark_playback(browser)
        if not playback["changed"] or not playback["stable"]:
            fail(f"Wordmark at {width}x{height} must change pixels during playback then hold a final frame; got {playback}.")

        evaluate(
            browser,
            """new Promise(resolve => {
              window.scrollTo(0, document.documentElement.scrollHeight);
              setTimeout(() => {
                window.scrollTo(0, 0);
                setTimeout(resolve, 150);
              }, 150);
            })""",
        )
        set_viewport(browser, width + 1, height)
        wait_for_animation_frames(browser)
        set_viewport(browser, width, height)
        wait_for_animation_frames(browser)
        try:
            browser.command("Emulation.setPageVisibilityState", {"visibilityState": "hidden"})
            browser.command("Emulation.setPageVisibilityState", {"visibilityState": "visible"})
        except BrowserError:
            pass
        wait_for_animation_frames(browser)
        after_lifecycle = wordmark_snapshot(browser, include_pixels=True)
        if not wordmark_pixels_remain_stable(browser):
            fail(f"Wordmark at {width}x{height} must not restart after scroll, resize, or visibility changes.")
        assert_matching_wordmark_bounds(after_lifecycle, f"Wordmark at {width}x{height} after lifecycle changes")
        assert_no_page_errors(after_lifecycle, f"Wordmark at {width}x{height}")
    finally:
        browser.close()


def check_disabled_wordmark(debug_url: str, origin: str, width: int, height: int) -> None:
    browser = open_page(debug_url, origin, "/__browser-check-blank__")
    try:
        set_viewport(browser, width, height)
        install_wordmark_observers(browser)
        enable_network_disable_cache_and_clear_browser_cache(browser)
        browser.command("Page.navigate", {"url": origin + "/"})
        wait_for_complete(browser, "/", f"homepage with laseretch disabled at {width}x{height}")
        snapshot = wordmark_snapshot(browser)
        enabled = evaluate(
            browser,
            'document.querySelector("[data-wordmark]")?.dataset.wordmarkEnhancement === "laseretch"',
        )
        if enabled:
            fail(f"Laseretch must be disabled at {width}x{height}.")
        assert_static_wordmark(snapshot, f"Laseretch-disabled homepage at {width}x{height}", None)
        if any("/assets/js/wte/" in resource for resource in snapshot["evidence"]["resources"]):
            fail(f"Laseretch-disabled homepage requested the WTE runtime: {snapshot['evidence']['resources']}.")
        assert_no_page_errors(snapshot, f"Laseretch-disabled homepage at {width}x{height}")
    finally:
        browser.close()


def check_wordmark_load_failure(debug_url: str, origin: str, blocked_url: str, description: str) -> None:
    browser = open_page(debug_url, origin, "/__browser-check-blank__")
    try:
        set_viewport(browser, 390, 844)
        install_wordmark_observers(browser)
        enable_network_disable_cache_and_clear_browser_cache(browser)
        browser.command("Network.setBlockedURLs", {"urls": [blocked_url]})
        browser.command("Page.navigate", {"url": origin + "/"})
        wait_for_complete(browser, "/", description)
        wait_for(
            browser,
            'document.querySelector("[data-wordmark]")?.dataset.wordmarkEnhanced === "false"',
            f"static wordmark after {description}",
        )
        terminal_at = evaluate(browser, "performance.now()")
        snapshot = wordmark_snapshot(browser)
        if terminal_at is None or terminal_at > 2000:
            fail(f"{description} must recover to the static wordmark within two seconds; got {terminal_at}ms.")
        assert_static_wordmark(snapshot, description, "false")
        assert_no_page_errors(snapshot, description)
    finally:
        browser.close()


def check_print_wordmark(debug_url: str, origin: str, laseretch_enabled: bool) -> None:
    browser = open_page(debug_url, origin, "/__browser-check-blank__")
    try:
        set_viewport(browser, 768, 1024)
        install_wordmark_observers(browser)
        enable_network_disable_cache_and_clear_browser_cache(browser)
        browser.command("Emulation.setEmulatedMedia", {"media": "print"})
        browser.command("Page.navigate", {"url": origin + "/"})
        wait_for_complete(browser, "/", "printed homepage")
        expected_state = "false" if laseretch_enabled else None
        if expected_state is not None:
            wait_for(
                browser,
                'document.querySelector("[data-wordmark]")?.dataset.wordmarkEnhanced === "false"',
                "static printed wordmark",
            )
        snapshot = wordmark_snapshot(browser)
        assert_static_wordmark(snapshot, "Printed homepage", expected_state)
        if laseretch_enabled and (snapshot["canvas"]["width"] or snapshot["canvas"]["height"]):
            fail(f"Printed homepage must have no Canvas output; got {snapshot['canvas']}.")
        assert_no_page_errors(snapshot, "Printed homepage")
    finally:
        browser.close()


def check_no_javascript(debug_url: str, origin: str) -> None:
    browser = open_page(debug_url, origin, "/__browser-check-blank__")
    try:
        set_viewport(browser, 390, 844)
        enable_network_disable_cache_and_clear_browser_cache(browser)
        browser.command("Network.setBlockedURLs", {"urls": ["*://127.0.0.1:*/*.js"]})
        browser.command("Page.navigate", {"url": origin + "/"})
        wait_for_complete(browser, "/", "homepage without JavaScript")
        fallback = evaluate(
            browser,
            """(() => {
              const details = document.querySelector("[data-quake-fallback]");
              const opener = document.querySelector("[data-drawer-open]");
              return Boolean(
                details && !details.hidden && !details.dataset.quakeEnhanced &&
                getComputedStyle(details).display !== "none" && details.querySelectorAll("a[href]").length > 0 &&
                opener?.hidden
              );
            })()""",
        )
        if not fallback:
            fail("Without JavaScript, the visible native navigation disclosure must retain its real links and unenhanced controls.")
        assert_static_wordmark(wordmark_snapshot(browser), "Homepage without JavaScript", None)
        click_element(browser, "[data-quake-fallback] summary")
        click_element(browser, '[data-quake-fallback] a[href="/foundation/"]')
        wait_for_complete(browser, "/foundation/", "no-JavaScript Foundation navigation")
        browser.command("Page.navigate", {"url": origin + "/"})
        wait_for_complete(browser, "/", "homepage without JavaScript")
        click_element(browser, '[data-spotlight-open][href="/search/"]')
        wait_for_complete(browser, "/search/", "no-JavaScript full search route")
        search_fallback = evaluate(
            browser,
            """(() => {
              const fallback = document.querySelector("main [data-site-search-fallback]");
              return Boolean(fallback && !fallback.hidden && fallback.querySelector('a[href="/foundation/"]') &&
                fallback.querySelector('a[href="/new-releases/"]') && !document.querySelector("[data-spotlight]")?.open);
            })()""",
        )
        if not search_fallback:
            fail("The no-JavaScript search route must offer site-wide navigation fallback content.")
    finally:
        browser.close()


def check_reduced_motion(debug_url: str, origin: str, laseretch_enabled: bool) -> None:
    browser = open_page(debug_url, origin, "/__browser-check-blank__")
    try:
        set_viewport(browser, 390, 844)
        install_wordmark_observers(browser)
        enable_network_disable_cache_and_clear_browser_cache(browser)
        browser.command(
            "Emulation.setEmulatedMedia",
            {"features": [{"name": "prefers-reduced-motion", "value": "reduce"}]},
        )
        browser.command("Page.navigate", {"url": origin + "/"})
        wait_for_complete(browser, "/", "homepage with reduced motion")
        expected_state = "false" if laseretch_enabled else None
        if expected_state is not None:
            wait_for(
                browser,
                'document.querySelector("[data-wordmark]")?.dataset.wordmarkEnhanced === "false"',
                "static reduced-motion wordmark",
            )
        wordmark = wordmark_snapshot(browser)
        assert_static_wordmark(wordmark, "Reduced-motion homepage", expected_state)
        if any("/assets/js/wte/" in resource for resource in wordmark["evidence"]["resources"]):
            fail(f"Reduced-motion homepage must not request the WTE runtime; got {wordmark['evidence']['resources']}.")
        assert_no_page_errors(wordmark, "Reduced-motion homepage")
        set_viewport(browser, 1440, 900)
        click_element(browser, "[data-quake-toggle]")
        wait_for(browser, 'document.querySelector("[data-quake-fallback]")?.open', "reduced-motion Quake panel")
        motion = evaluate(
            browser,
            """(() => {
              const panel = document.querySelector("[data-quake-fallback]");
              return {
                state: panel.dataset.quakeState,
                transform: getComputedStyle(panel).transform,
                focused: document.activeElement === panel.querySelector("nav > section h2 > a")
              };
            })()""",
        )
        if motion["state"] != "open" or motion["transform"] != "none" or not motion["focused"]:
            fail(f"Reduced motion must reveal the same Quake state without translated animation; got {motion}.")
        press_key(browser, "Escape", "Escape", 27)
        wait_for(browser, '!document.querySelector("[data-quake-fallback]")?.open', "reduced-motion Quake dismissal")
    finally:
        browser.close()


def check_spotlight(browser: DevToolsSocket, origin: str, width: int, height: int) -> None:
    browser.command("Page.navigate", {"url": origin + "/"})
    wait_for_complete(browser, "/")
    set_viewport(browser, width, height)
    evaluate(browser, "window.scrollTo(0, 240)")
    click_element(browser, "[data-spotlight-open]")
    wait_for(browser, 'document.querySelector("[data-spotlight]")?.open', "Spotlight to open")
    blank = evaluate(
        browser,
        """(() => {
          const dialog = document.querySelector("[data-spotlight]");
          const input = dialog?.querySelector("input[name='q']");
          const rect = dialog?.getBoundingClientRect();
          return {
            focused: document.activeElement === input,
            blank: input?.value === "" && !dialog?.querySelector("[data-site-search-status]")?.textContent.trim() &&
              dialog?.querySelectorAll("[data-search-result]").length === 0,
            quiet: dialog?.querySelector("[data-site-search-fallback]")?.hidden === true,
            geometry: rect && rect.width <= 42 * 16 + 1 && rect.height <= innerHeight * 0.7 + 1,
            scrollLocked: document.documentElement.style.overflow === "hidden" &&
              getComputedStyle(document.body).position === "fixed",
            withinViewport: rect && rect.left >= 0 && rect.top >= 0 && rect.right <= innerWidth && rect.bottom <= innerHeight,
            noOverflow: document.documentElement.scrollWidth <= document.documentElement.clientWidth + 1
          };
        })()""",
    )
    if not blank["focused"] or not blank["blank"] or not blank["quiet"] or not blank["geometry"] or not blank["scrollLocked"] or not blank["withinViewport"] or not blank["noOverflow"]:
        fail(f"Spotlight must open focused, quiet, scroll-locked, and within its viewport geometry at {width}x{height}; got {blank}.")
    for _ in range(4):
        press_key(browser, "Tab", "Tab", 9)
    if not evaluate(browser, 'document.querySelector("[data-spotlight]")?.contains(document.activeElement)'):
        fail("Spotlight must retain keyboard focus within its native modal.")
    click_element(browser, "[data-spotlight-close]")
    wait_for(browser, '!document.querySelector("[data-spotlight]")?.open', "Spotlight close control")
    wait_for(browser, 'document.activeElement === document.querySelector("[data-spotlight-open]")', "Spotlight focus restoration")
    if not evaluate(browser, 'document.documentElement.style.overflow === "" && getComputedStyle(document.body).position !== "fixed"'):
        fail("Closing Spotlight must restore document scrolling.")

    click_element(browser, "[data-spotlight-open]")
    wait_for(browser, 'document.querySelector("[data-spotlight]")?.open', "Spotlight backdrop dismissal")
    backdrop_point = evaluate(
        browser,
        """(() => {
          const rect = document.querySelector("[data-spotlight]").getBoundingClientRect();
          return {x: Math.max(1, rect.left - 2), y: Math.max(1, rect.top + 2)};
        })()""",
    )
    click_at(browser, backdrop_point["x"], backdrop_point["y"])
    wait_for(browser, '!document.querySelector("[data-spotlight]")?.open', "Spotlight backdrop dismissal")
    wait_for(browser, 'document.activeElement === document.querySelector("[data-spotlight-open]")', "Spotlight backdrop focus restoration")

    press_key(browser, "k", "KeyK", 75, modifiers=2)
    wait_for(browser, 'document.querySelector("[data-spotlight]")?.open', "Ctrl+K to open Spotlight")
    if not evaluate(browser, 'document.activeElement === document.querySelector(\'[data-spotlight] input[name="q"]\')'):
        fail("Ctrl+K must move focus directly to Spotlight's query field.")
    press_key(browser, "k", "KeyK", 75, modifiers=2)
    if not evaluate(browser, 'document.querySelector("[data-spotlight]")?.open && document.activeElement === document.querySelector(\'[data-spotlight] input[name="q"]\')'):
        fail("Repeated Ctrl+K must focus the existing Spotlight rather than creating another state.")
    press_key(browser, "`", "Backquote", 192, modifiers=2)
    if evaluate(browser, 'document.querySelector("[data-quake-fallback]")?.open || document.querySelector("[data-drawer]")?.open'):
        fail("Navigation shortcuts must be ignored while typing in Spotlight.")
    press_key(browser, "Escape", "Escape", 27)
    wait_for(browser, '!document.querySelector("[data-spotlight]")?.open', "Escape to dismiss Spotlight")
    wait_for(browser, 'document.activeElement === document.querySelector("[data-spotlight-open]")', "Spotlight Escape focus restoration")

    dispatch_ctrl_shortcut(browser, "k", "KeyT")
    wait_for(browser, 'document.querySelector("[data-spotlight]")?.open', "logical Ctrl+K to open Spotlight")
    if not evaluate(browser, 'document.activeElement === document.querySelector(\'[data-spotlight] input[name="q"]\')'):
        fail("Logical Ctrl+K must move focus directly to Spotlight's query field.")
    press_key(browser, "Escape", "Escape", 27)
    wait_for(browser, '!document.querySelector("[data-spotlight]")?.open', "logical Ctrl+K Spotlight cleanup")
    wait_for(browser, 'document.activeElement === document.querySelector("[data-spotlight-open]")', "logical Ctrl+K focus restoration")

    click_element(browser, "[data-quake-toggle]")
    wait_for(browser, 'document.querySelector("[data-quake-fallback]")?.open', "Quake before Spotlight exclusivity check")
    click_element(browser, "[data-spotlight-open]")
    wait_for(browser, 'document.querySelector("[data-spotlight]")?.open && !document.querySelector("[data-quake-fallback]")?.open', "Spotlight to replace Quake")
    press_key(browser, "Escape", "Escape", 27)
    wait_for(browser, '!document.querySelector("[data-spotlight]")?.open', "Spotlight dismissal before reciprocal exclusivity check")
    click_element(browser, "[data-spotlight-open]")
    wait_for(browser, 'document.querySelector("[data-spotlight]")?.open', "Spotlight before Quake exclusivity check")
    click_element(browser, "[data-quake-toggle]")
    wait_for(browser, 'document.querySelector("[data-quake-fallback]")?.open && !document.querySelector("[data-spotlight]")?.open', "Quake to replace Spotlight")
    press_key(browser, "Escape", "Escape", 27)
    wait_for(browser, '!document.querySelector("[data-quake-fallback]")?.open', "Quake dismissal before search")

    click_element(browser, "[data-spotlight-open]")
    wait_for(browser, 'document.querySelector("[data-spotlight]")?.open', "Spotlight search")
    set_search_query(browser, '[data-spotlight] input[name="q"]', "f")
    if not evaluate(browser, 'document.querySelector("[data-spotlight] [data-site-search-status]")?.textContent.trim() === "" && document.querySelector("[data-spotlight] [data-search-result]") === null'):
        fail("Spotlight must remain quiet until a trimmed query reaches two characters.")
    set_search_query(browser, '[data-spotlight] input[name="q"]', "foundation")
    wait_for(browser, 'document.querySelector("[data-spotlight] [data-site-search-status]")?.textContent.includes("result")', "real Pagefind Spotlight results")
    groups = evaluate(
        browser,
        """(() => Array.from(document.querySelectorAll("[data-spotlight] .site-search__group"), group => ({
          title: group.querySelector("h2")?.textContent.trim(),
          count: group.querySelectorAll("[data-search-result]").length,
          external: Array.from(group.querySelectorAll(".site-search__external"), item => item.textContent.trim())
        })))()""",
    )
    if [group["title"] for group in groups] != ["Destinations", "Pages & News"] or groups[0]["count"] > 5 or groups[1]["count"] > 8:
        fail(f"Spotlight must rank bounded destination results before bounded Pagefind results; got {groups}.")
    set_search_query(browser, '[data-spotlight] input[name="q"]', "manual")
    wait_for(browser, 'document.querySelector("[data-spotlight] [data-site-search-status]")?.textContent.includes("result")', "Manual search results")
    if not evaluate(browser, 'document.querySelector("[data-spotlight] .site-search__group [data-search-result]")?.parentElement.parentElement.querySelector(".site-search__external")?.textContent.trim() === "External"'):
        fail("External curated destinations must identify that they leave the site.")

    set_search_query(browser, '[data-spotlight] input[name="q"]', "foundation")
    wait_for(browser, 'document.querySelector("[data-spotlight] [data-site-search-status]")?.textContent === "Searching…"', "an in-flight search")
    set_search_query(browser, '[data-spotlight] input[name="q"]', "zzqxv")
    wait_for(browser, 'document.querySelector("[data-spotlight] [data-site-search-status]")?.textContent.includes("No results for “zzqxv”.")', "the newest no-results query")
    latest = evaluate(
        browser,
        """(() => ({
          value: document.querySelector("[data-spotlight] input[name='q']")?.value,
          results: document.querySelectorAll("[data-spotlight] [data-search-result]").length
        }))()""",
    )
    if latest != {"value": "zzqxv", "results": 0}:
        fail(f"An older Spotlight search must never replace the current query's empty state; got {latest}.")

    set_search_query(browser, '[data-spotlight] input[name="q"]', "foundation")
    wait_for(browser, 'document.querySelector("[data-spotlight] [data-search-result]") !== null', "keyboard-search results")
    press_key(browser, "ArrowDown", "ArrowDown", 40)
    selected = evaluate(
        browser,
        """(() => {
          const selected = document.querySelector("[data-spotlight] [data-search-result].is-active");
          return selected && new URL(selected.href).pathname;
        })()""",
    )
    if selected != "/foundation/":
        fail(f"Arrow selection must begin with the first ranked destination; got {selected}.")
    press_key(browser, "Enter", "Enter", 13)
    wait_for_complete(browser, "/foundation/", "Enter on the selected Spotlight result")


def check_full_search(debug_url: str, origin: str) -> None:
    browser = open_page(debug_url, origin, "/search/?q=foundation")
    try:
        set_viewport(browser, 1440, 900)
        browser.command("Page.navigate", {"url": origin + "/search/?q=foundation"})
        wait_for_complete(browser, "/search/")
        wait_for(browser, 'document.querySelector("[data-site-search] [data-site-search-status]")?.textContent.includes("result")', "full search Pagefind results")
        full = evaluate(
            browser,
            """(() => ({
              value: document.querySelector("[data-site-search] input[name='q']")?.value,
              groups: Array.from(document.querySelectorAll("main [data-site-search] .site-search__group"), group => ({
                title: group.querySelector("h2")?.textContent.trim(),
                count: group.querySelectorAll("[data-search-result]").length
              }))
            }))()""",
        )
        if full["value"] != "foundation" or [group["title"] for group in full["groups"]] != ["Destinations", "Pages & News"] or full["groups"][0]["count"] > 5 or full["groups"][1]["count"] > 8:
            fail(f"The full search route must share Spotlight query and result rules; got {full}.")
        set_search_query(browser, '[data-site-search] input[name="q"]', "zzqxv")
        wait_for(browser, 'document.querySelector("[data-site-search] [data-site-search-status]")?.textContent.includes("No results for “zzqxv”.")', "full-search no-results state")
    finally:
        browser.close()


def check_unavailable_search(debug_url: str, origin: str) -> None:
    browser = open_page(debug_url, origin, "/search/")
    try:
        set_viewport(browser, 1440, 900)
        browser.command("Network.enable")
        browser.command("Network.setBlockedURLs", {"urls": ["*://127.0.0.1:*/pagefind/*"]})
        browser.command("Page.navigate", {"url": origin + "/search/"})
        wait_for_complete(browser, "/search/")
        set_search_query(browser, '[data-site-search] input[name="q"]', "foundation")
        wait_for(browser, 'document.querySelector("[data-site-search] [data-site-search-status]")?.textContent.trim() === "Search is unavailable."', "unavailable search state")
        fallback = evaluate(
            browser,
            """(() => {
              const fallback = document.querySelector("[data-site-search-fallback]");
              return !fallback.hidden && Boolean(fallback.querySelector('a[href="/foundation/"]')) &&
                Boolean(fallback.querySelector('a[href="/new-releases/"]')) && !fallback.textContent.toLocaleLowerCase().includes("news archive");
            })()""",
        )
        if not fallback:
            fail("Unavailable full search must expose site-wide fallback navigation rather than a News-only archive.")
        click_element(browser, "[data-spotlight-open]")
        wait_for(browser, 'document.querySelector("[data-spotlight]")?.open', "unavailable Spotlight")
        set_search_query(browser, '[data-spotlight] input[name="q"]', "foundation")
        wait_for(browser, 'document.querySelector("[data-spotlight] [data-site-search-status]")?.textContent.trim() === "Search is unavailable."', "unavailable Spotlight state")
        fallback = evaluate(
            browser,
            """(() => {
              const fallback = document.querySelector("[data-spotlight] [data-site-search-fallback]");
              return !fallback.hidden && Boolean(fallback.querySelector('a[href="/foundation/"]')) &&
                Boolean(fallback.querySelector('a[href="/new-releases/"]')) && !fallback.textContent.toLocaleLowerCase().includes("news archive");
            })()""",
        )
        if not fallback:
            fail("Unavailable Spotlight must expose the same site-wide fallback navigation as full search.")
    finally:
        browser.close()


def check_mobile_spotlight(browser: DevToolsSocket, origin: str) -> None:
    browser.command("Page.navigate", {"url": origin + "/"})
    wait_for_complete(browser, "/")
    set_viewport(browser, 390, 844)
    press_key(browser, "k", "KeyK", 75, modifiers=2)
    wait_for(browser, 'document.querySelector("[data-spotlight]")?.open', "mobile Ctrl+K Spotlight")
    mobile = evaluate(
        browser,
        """(() => {
          const dialog = document.querySelector("[data-spotlight]");
          const rect = dialog.getBoundingClientRect();
          return {
            focused: document.activeElement === dialog.querySelector("input[name='q']"),
            margins: rect.left >= 1 && rect.right <= innerWidth - 1,
            noOverflow: document.documentElement.scrollWidth <= document.documentElement.clientWidth + 1
          };
        })()""",
    )
    if not mobile["focused"] or not mobile["margins"] or not mobile["noOverflow"]:
        fail(f"Mobile Spotlight must fit within safe viewport margins without overflow; got {mobile}.")
    press_key(browser, "Escape", "Escape", 27)
    wait_for(browser, '!document.querySelector("[data-spotlight]")?.open', "mobile Spotlight dismissal")

def check_news(browser: DevToolsSocket) -> None:
    featured = evaluate(
        browser,
        """(() => {
          const route = '/news/2026/08/the-first-plugin-competition-winners/';
          const card = Array.from(document.querySelectorAll('article.news-card')).find(article =>
            article.querySelector('.news-card__media')?.getAttribute('href') === route
          );
          const image = card?.querySelector('.news-card__media img');
          return image && {
            src: image.currentSrc || image.src,
            alt: image.alt,
            width: image.naturalWidth
          };
        })()""",
    )
    if not featured or "radio-atlas" not in featured["src"] or not featured["alt"].strip() or featured["width"] <= 0:
        fail("Configured featured News story must render its cleared real Radio Atlas lead image with useful alt text.")


def check_news_partition(debug_url: str, origin: str) -> None:
    def article_links(route: str, selector: str) -> list[str]:
        browser = open_page(debug_url, origin, route)
        try:
            set_viewport(browser, 1440, 900)
            browser.command("Page.navigate", {"url": origin + route})
            wait_for_complete(browser, route)
            return evaluate(
                browser,
                f"""(() => Array.from(document.querySelectorAll({json.dumps(selector)}), link => link.pathname))()""",
            )
        finally:
            browser.close()

    first = article_links("/news/", "#archive .news-archive li > a")
    second = article_links("/news/page/2/", ".news-index__latest > .news-card-grid > article.news-card .news-card__media")
    if len(first) != 9 or len(second) != 3 or len(set(first)) != 9 or len(set(second)) != 3:
        fail(f"News archive must render nine unique page-one stories and three unique page-two stories; got {first} / {second}.")
    if set(first) & set(second) or len(set(first) | set(second)) != 12:
        fail("News archive pages overlap or omit a story; page one and page two must partition all twelve articles.")


def check_proof_media(browser: DevToolsSocket, route: str, selector: str, description: str, origin: str) -> None:
    media = evaluate(
        browser,
        f"""(() => Array.from(document.querySelectorAll({json.dumps(selector)}), image => ({{
          src: image.currentSrc || image.src, alt: image.alt, loading: image.loading, width: image.naturalWidth
        }})))()""",
    )
    if not media:
        fail(f"{route} must render cleared current-proof media for {description}.")
    for image in media:
        parsed = urllib.parse.urlsplit(image["src"])
        if (
            f"{parsed.scheme}://{parsed.netloc}" != origin
            or not parsed.path.startswith("/assets/")
            or not image["alt"].strip()
            or image["loading"] != "lazy"
            or image["width"] <= 0
        ):
            fail(f"{route} current-proof media for {description} must be loaded local media with alt text and lazy loading: {image}.")


def run() -> None:
    if not SITE.is_dir():
        fail("Missing _site; build the rendered site before browser acceptance verification.")

    with ChromiumSession(SITE) as session:
        for width, height in VIEWPORTS:
            for route in ROUTES:
                browser = session.open_page(route)
                try:
                    set_viewport(browser, width, height)
                    browser.command("Page.navigate", {"url": session.origin + route})
                    wait_for_complete(browser, route)
                    check_page_shell(browser, route, width, height, session.origin)
                    check_route_semantics(browser, route)
                    if route == "/":
                        check_home_actions(browser)
                        check_home_scene(browser, width, height)
                        check_home_scroll_cue(browser, width, height)
                        check_header_transition(browser)
                        check_closed_responsive_header(browser, width)
                        if width == 390:
                            check_mobile_drawer(browser)
                    elif route == "/news/":
                        check_news(browser)
                    elif route == "/workstations/":
                        check_proof_media(browser, route, ".workstation-gallery__item img", "Workstations", session.origin)
                finally:
                    browser.close()

        browser = session.open_page("/")
        try:
            set_viewport(browser, 1440, 900)
            wait_for_complete(browser, "/")
            check_navigation_inventory(browser)
            check_direct_navigation(browser, session.origin)
            check_current_navigation(browser, session.origin)
            check_desktop_quake(browser, session.origin)
            check_spotlight(browser, session.origin, 1440, 900)
        finally:
            browser.close()

        browser = session.open_page("/")
        try:
            set_viewport(browser, 1440, 900)
            check_short_quake(browser, session.origin)
            check_navigation_shortcuts(browser, session.origin, 1440)
        finally:
            browser.close()

        browser = session.open_page("/")
        try:
            set_viewport(browser, 768, 1024)
            wait_for_complete(browser, "/")
            check_closed_responsive_header(browser, 768)
            check_navigation_shortcuts(browser, session.origin, 768)
        finally:
            browser.close()

        browser = session.open_page("/")
        try:
            set_viewport(browser, 390, 844)
            check_navigation_shortcuts(browser, session.origin, 390)
            check_mobile_spotlight(browser, session.origin)
        finally:
            browser.close()

        laseretch_enabled = 'data-wordmark-enhancement="laseretch"' in (SITE / "index.html").read_text()
        if laseretch_enabled:
            for width, height in VIEWPORTS:
                check_normal_wordmark(session.debug_url, session.origin, width, height)
            check_wordmark_load_failure(
                session.debug_url,
                session.origin,
                "*/assets/js/wte/laseretch.wasm",
                "blocked laseretch WebAssembly",
            )
            check_wordmark_load_failure(
                session.debug_url,
                session.origin,
                "*/assets/js/wte/assets/playback-*.js",
                "blocked WTE playback module",
            )
        else:
            for width, height in VIEWPORTS:
                check_disabled_wordmark(session.debug_url, session.origin, width, height)
        check_print_wordmark(session.debug_url, session.origin, laseretch_enabled)

        check_news_partition(session.debug_url, session.origin)
        check_no_javascript(session.debug_url, session.origin)
        check_reduced_motion(session.debug_url, session.origin, laseretch_enabled)
        check_full_search(session.debug_url, session.origin)
        check_unavailable_search(session.debug_url, session.origin)

    print("Rendered Chromium route, media, navigation, search, pagination, motion, and viewport checks passed.")


if __name__ == "__main__":
    try:
        run()
    except (VerificationError, BrowserError) as error:
        print(f"Rendered-site acceptance failed: {error}", file=sys.stderr)
        sys.exit(1)
