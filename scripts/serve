#!/usr/bin/env bash
set -euo pipefail

children=()

terminate_children() {
  local pid
  local killer_pid

  for pid in "${children[@]}"; do
    kill -TERM -- "-$pid" 2>/dev/null || true
  done

  (
    sleep 5
    for pid in "${children[@]}"; do
      kill -KILL -- "-$pid" 2>/dev/null || true
    done
  ) &
  killer_pid=$!

  for pid in "${children[@]}"; do
    wait "$pid" 2>/dev/null || true
  done

  kill -TERM -- "-$killer_pid" 2>/dev/null || true
  wait "$killer_pid" 2>/dev/null || true
}

cleanup() {
  local status=$?

  trap - EXIT HUP INT TERM
  terminate_children
  exit "$status"
}

start() {
  "$@" &
  children+=("$!")
}

# Give each background job its own process group so cleanup also reaches any
# compiler or server subprocesses.
set -m

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

start scripts/build css --watch
start jigyll serve -s . -w --unpublished "$@"

if wait -n "${children[@]}"; then
  status=0
else
  status=$?
fi

exit "$status"
