#!/usr/bin/env sh
set -eu

scripts/build css
scripts/build js
jigyll build -s . --unpublished
npx --no-install pagefind --site _site --output-path pagefind

server_pid=
watcher_pid=

cleanup() {
  trap - EXIT HUP INT TERM
  [ -z "$watcher_pid" ] || kill "$watcher_pid" 2>/dev/null || true
  [ -z "$server_pid" ] || kill "$server_pid" 2>/dev/null || true
  [ -z "$watcher_pid" ] || wait "$watcher_pid" 2>/dev/null || true
  [ -z "$server_pid" ] || wait "$server_pid" 2>/dev/null || true
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

node scripts/watch-pagefind.mjs _site pagefind &
watcher_pid=$!
jigyll serve -s . -w --unpublished "$@" &
server_pid=$!

while kill -0 "$watcher_pid" 2>/dev/null && kill -0 "$server_pid" 2>/dev/null; do
  sleep 1
done

status=0
if ! kill -0 "$server_pid" 2>/dev/null; then
  wait "$server_pid" || status=$?
else
  wait "$watcher_pid" || status=$?
fi
exit "$status"
