#!/usr/bin/env sh
set -eu

fail() {
  printf '%s\n' "$*" >&2
  exit 1
}

usage() {
  printf '%s\n' 'Usage: scripts/build-assets [--check]'
}

mode=write
case "${1-}" in
  '')
    ;;
  --check)
    mode=check
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "Missing required command: $1"
}

require_command magick
require_command woff2_compress
require_command cmp
require_command mktemp

export MAGICK_THREAD_LIMIT=1

hero_source=__docs/images/0-winding-road.jpg
news_preview_source=__docs/images/news/radio-atlas-preview.webp
desktop_preview_source=__docs/images/desktop/tokyo-night-preview.png
pleum_workstation_source=__docs/images/workstations/pleum-p1554011.jpg
sspaeti_workstation_source=__docs/images/workstations/sspaeti-office-setup.jpg
font_subset_directory=__docs/fonts/jetbrains-mono-2.304/subsets

[ -f "$hero_source" ] || fail "Missing approved source: $hero_source"
[ -f "$news_preview_source" ] || fail "Missing approved source: $news_preview_source"
[ -f "$desktop_preview_source" ] || fail "Missing approved source: $desktop_preview_source"
[ -f "$pleum_workstation_source" ] || fail "Missing approved source: $pleum_workstation_source"
[ -f "$sspaeti_workstation_source" ] || fail "Missing approved source: $sspaeti_workstation_source"
[ -f "$font_subset_directory/JetBrainsMono-Light.ttf" ] || fail "Missing generated font source: $font_subset_directory/JetBrainsMono-Light.ttf"
[ -f "$font_subset_directory/JetBrainsMono-LightItalic.ttf" ] || fail "Missing generated font source: $font_subset_directory/JetBrainsMono-LightItalic.ttf"
[ -f "$font_subset_directory/JetBrainsMono-Medium.ttf" ] || fail "Missing generated font source: $font_subset_directory/JetBrainsMono-Medium.ttf"
[ -f "$font_subset_directory/JetBrainsMono-Bold.ttf" ] || fail "Missing generated font source: $font_subset_directory/JetBrainsMono-Bold.ttf"

output_paths='
assets/images/hero/winding-road-480w.webp
assets/images/hero/winding-road-768w.webp
assets/images/hero/winding-road-1200w.webp
assets/images/hero/winding-road-1600w.webp
assets/images/hero/winding-road-portrait-480w.webp
assets/images/hero/winding-road-portrait-768w.webp
assets/images/hero/winding-road-portrait-1200w.webp
assets/images/news/radio-atlas-preview-1180w.webp
assets/images/desktop/tokyo-night-preview-480w.webp
assets/images/desktop/tokyo-night-preview-768w.webp
assets/images/desktop/tokyo-night-preview-1200w.webp
assets/images/desktop/tokyo-night-preview-1600w.webp
assets/images/workstations/pleum-p1554011-480w.webp
assets/images/workstations/pleum-p1554011-768w.webp
assets/images/workstations/pleum-p1554011-1200w.webp
assets/images/workstations/pleum-p1554011-1600w.webp
assets/images/workstations/sspaeti-office-setup-480w.webp
assets/images/workstations/sspaeti-office-setup-768w.webp
assets/images/workstations/sspaeti-office-setup-1200w.webp
assets/images/workstations/sspaeti-office-setup-1600w.webp
assets/fonts/jetbrains-mono-light.woff2
assets/fonts/jetbrains-mono-light-italic.woff2
assets/fonts/jetbrains-mono-medium.woff2
assets/fonts/jetbrains-mono-bold.woff2
'

render_wide() {
  width=$1
  height=$2
  output=$3

  magick "$hero_source" \
    -auto-orient \
    -colorspace sRGB \
    -strip \
    -resize "${width}x${height}^" \
    -gravity center \
    -extent "${width}x${height}" \
    -quality 82 \
    -define webp:method=6 \
    -define webp:thread-level=0 \
    "$output"
}

render_portrait() {
  width=$1
  height=$2
  output=$3

  magick "$hero_source" \
    -auto-orient \
    -colorspace sRGB \
    -strip \
    -crop 1904x3384+2750+0 +repage \
    -resize "${width}x${height}^" \
    -gravity center \
    -extent "${width}x${height}" \
    -quality 82 \
    -define webp:method=6 \
    -define webp:thread-level=0 \
    "$output"
}
render_news_preview() {
  output=$1

  magick "$news_preview_source" \
    -auto-orient \
    -colorspace sRGB \
    -strip \
    -resize 1180x \
    -quality 82 \
    -define webp:method=6 \
    -define webp:thread-level=0 \
    "$output"
}


render_responsive_image() {
  source=$1
  width=$2
  output=$3

  magick "$source" \
    -auto-orient \
    -colorspace sRGB \
    -strip \
    -resize "${width}x" \
    -quality 82 \
    -define webp:method=6 \
    -define webp:thread-level=0 \
    "$output"
}

compress_font() {
  source=$1
  output=$2
  temporary_ttf="${output%.woff2}.ttf"

  cp "$source" "$temporary_ttf"
  woff2_compress "$temporary_ttf"
  rm "$temporary_ttf"
}

render_all() {
  destination=$1

  mkdir -p "$destination/assets/images/hero" "$destination/assets/images/news" "$destination/assets/images/desktop" "$destination/assets/images/workstations" "$destination/assets/fonts"
  render_wide 480 270 "$destination/assets/images/hero/winding-road-480w.webp"
  render_wide 768 432 "$destination/assets/images/hero/winding-road-768w.webp"
  render_wide 1200 675 "$destination/assets/images/hero/winding-road-1200w.webp"
  render_wide 1600 900 "$destination/assets/images/hero/winding-road-1600w.webp"
  render_portrait 480 854 "$destination/assets/images/hero/winding-road-portrait-480w.webp"
  render_portrait 768 1365 "$destination/assets/images/hero/winding-road-portrait-768w.webp"
  render_portrait 1200 2133 "$destination/assets/images/hero/winding-road-portrait-1200w.webp"
  render_news_preview "$destination/assets/images/news/radio-atlas-preview-1180w.webp"
  render_responsive_image "$desktop_preview_source" 480 "$destination/assets/images/desktop/tokyo-night-preview-480w.webp"
  render_responsive_image "$desktop_preview_source" 768 "$destination/assets/images/desktop/tokyo-night-preview-768w.webp"
  render_responsive_image "$desktop_preview_source" 1200 "$destination/assets/images/desktop/tokyo-night-preview-1200w.webp"
  render_responsive_image "$desktop_preview_source" 1600 "$destination/assets/images/desktop/tokyo-night-preview-1600w.webp"

  render_responsive_image "$pleum_workstation_source" 480 "$destination/assets/images/workstations/pleum-p1554011-480w.webp"
  render_responsive_image "$pleum_workstation_source" 768 "$destination/assets/images/workstations/pleum-p1554011-768w.webp"
  render_responsive_image "$pleum_workstation_source" 1200 "$destination/assets/images/workstations/pleum-p1554011-1200w.webp"
  render_responsive_image "$pleum_workstation_source" 1600 "$destination/assets/images/workstations/pleum-p1554011-1600w.webp"

  render_responsive_image "$sspaeti_workstation_source" 480 "$destination/assets/images/workstations/sspaeti-office-setup-480w.webp"
  render_responsive_image "$sspaeti_workstation_source" 768 "$destination/assets/images/workstations/sspaeti-office-setup-768w.webp"
  render_responsive_image "$sspaeti_workstation_source" 1200 "$destination/assets/images/workstations/sspaeti-office-setup-1200w.webp"
  render_responsive_image "$sspaeti_workstation_source" 1600 "$destination/assets/images/workstations/sspaeti-office-setup-1600w.webp"

  compress_font "$font_subset_directory/JetBrainsMono-Light.ttf" "$destination/assets/fonts/jetbrains-mono-light.woff2"
  compress_font "$font_subset_directory/JetBrainsMono-LightItalic.ttf" "$destination/assets/fonts/jetbrains-mono-light-italic.woff2"
  compress_font "$font_subset_directory/JetBrainsMono-Medium.ttf" "$destination/assets/fonts/jetbrains-mono-medium.woff2"
  compress_font "$font_subset_directory/JetBrainsMono-Bold.ttf" "$destination/assets/fonts/jetbrains-mono-bold.woff2"
}

if [ "$mode" = check ]; then
  temporary_directory=$(mktemp -d)
  cleanup() {
    rm -rf "$temporary_directory"
  }
  trap cleanup EXIT HUP INT TERM

  render_all "$temporary_directory"
  for output in $output_paths; do
    [ -f "$output" ] || fail "Missing committed derivative: $output"
    cmp -s "$temporary_directory/$output" "$output" || fail "Derivative differs from deterministic render: $output"
  done
  printf '%s\n' 'Asset derivatives are byte-identical.'
  exit 0
fi

render_all .
printf '%s\n' 'Rendered deterministic image and font derivatives.'
