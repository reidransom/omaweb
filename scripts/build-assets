#!/usr/bin/env sh
set -eu

fail() {
  printf '%s\n' "$*" >&2
  exit 1
}

usage() {
  printf '%s\n' 'Usage: scripts/build-assets [--check]'
}

mode=write
case "${1-}" in
  '')
    ;;
  --check)
    mode=check
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "Missing required command: $1"
}

require_command magick
require_command node
require_command cmp
require_command mktemp
require_command find
require_command sort

export MAGICK_THREAD_LIMIT=1

image_source_directory=../omaweb-docs/images
mono_font_source_directory=../omaweb-docs/fonts/jetbrains-mono-2.304
serif_font_source_directory=../omaweb-docs/fonts/source-serif-4.005
readable_font_source_directory=../omaweb-docs/fonts/atkinson-hyperlegible-next-2.001
hero_portrait_sizes='480:854 768:1365 1200:2133'

widths_for_size() {
  case "$1" in
    xl) printf '%s\n' '480 768 1200 1600' ;;
    lg) printf '%s\n' '480 768 1152' ;;
    md) printf '%s\n' '480 768' ;;
    *) fail "Unknown image size class: $1" ;;
  esac
}

find_files() {
  find "$1" -type f | sort
}

find_raster_sources() {
  find "$1" -type f \
    \( -name '*.jpg' -o -name '*.jpeg' -o -name '*.png' -o -name '*.webp' \) \
    | sort
}

require_source_directory() {
  directory=$1
  [ -d "$directory" ] || fail "Missing approved source directory: $directory"
  [ -n "$(find_files "$directory")" ] || fail "No approved images found in: $directory"
}

responsive_output_paths() {
  size=$1
  size_directory=$image_source_directory/$size
  widths=$(widths_for_size "$size")

  find "$size_directory" -mindepth 1 -maxdepth 1 -type d | sort | while IFS= read -r mode_directory; do
    mode=${mode_directory##*/}
    case "$mode" in
      wide|fit) ;;
      *) fail "Unknown image render mode: $mode_directory" ;;
    esac

    find_raster_sources "$mode_directory" | while IFS= read -r source; do
      relative_path=${source#"$mode_directory/"}
      output_stem=${relative_path%.*}
      for width in $widths; do
        printf 'assets/images/%s-%sw.webp\n' "$output_stem" "$width"
      done
    done
  done
}

copied_output_paths() {
  copy_directory=$image_source_directory/copy

  find_files "$copy_directory" | while IFS= read -r source; do
    printf 'assets/images/%s\n' "${source#"$copy_directory/"}"
  done
}

for directory in \
  "$image_source_directory/xl" \
  "$image_source_directory/lg" \
  "$image_source_directory/md" \
  "$image_source_directory/copy"
do
  require_source_directory "$directory"
done

for source in \
  "$mono_font_source_directory/JetBrainsMono-Light.ttf" \
  "$mono_font_source_directory/JetBrainsMono-LightItalic.ttf" \
  "$mono_font_source_directory/JetBrainsMono-Regular.ttf" \
  "$mono_font_source_directory/JetBrainsMono-Medium.ttf" \
  "$mono_font_source_directory/JetBrainsMono-Bold.ttf" \
  "$serif_font_source_directory/SourceSerif4-Regular.ttf" \
  "$serif_font_source_directory/SourceSerif4-It.ttf" \
  "$serif_font_source_directory/SourceSerif4-Bold.ttf" \
  "$readable_font_source_directory/AtkinsonHyperlegibleNext-Regular.ttf" \
  "$readable_font_source_directory/AtkinsonHyperlegibleNext-Italic.ttf" \
  "$readable_font_source_directory/AtkinsonHyperlegibleNext-Bold.ttf"
do
  [ -f "$source" ] || fail "Missing approved source: $source"
done

output_paths='
assets/fonts/jetbrains-mono-light.woff2
assets/fonts/jetbrains-mono-light-italic.woff2
assets/fonts/jetbrains-mono-regular.woff2
assets/fonts/jetbrains-mono-medium.woff2
assets/fonts/jetbrains-mono-bold.woff2
assets/fonts/source-serif-4-regular.woff2
assets/fonts/source-serif-4-italic.woff2
assets/fonts/source-serif-4-bold.woff2
assets/fonts/atkinson-hyperlegible-next-regular.woff2
assets/fonts/atkinson-hyperlegible-next-italic.woff2
assets/fonts/atkinson-hyperlegible-next-bold.woff2
'
for size in xl lg md; do
  output_paths="$output_paths
$(responsive_output_paths "$size")"
done
output_paths="$output_paths
$(copied_output_paths)"
for dimensions in $hero_portrait_sizes; do
  width=${dimensions%:*}
  output_paths="$output_paths
assets/images/hero/winding-road-portrait-${width}w.webp"
done

render_image() {
  mode=$1
  source=$2
  width=$3
  output=$4

  case "$mode" in
    wide)
      height=$((width * 9 / 16))
      magick "$source" \
        -auto-orient \
        -colorspace sRGB \
        -strip \
        -resize "${width}x${height}^" \
        -gravity center \
        -extent "${width}x${height}" \
        -quality 82 \
        -define webp:method=6 \
        -define webp:thread-level=0 \
        "$output"
      ;;
    fit)
      magick "$source" \
        -auto-orient \
        -colorspace sRGB \
        -strip \
        -resize "${width}x" \
        -quality 82 \
        -define webp:method=6 \
        -define webp:thread-level=0 \
        "$output"
      ;;
    *)
      fail "Unknown image render mode: $mode"
      ;;
  esac
}

render_size_class() {
  destination=$1
  size=$2
  size_directory=$image_source_directory/$size
  widths=$(widths_for_size "$size")

  find "$size_directory" -mindepth 1 -maxdepth 1 -type d | sort | while IFS= read -r mode_directory; do
    mode=${mode_directory##*/}
    find_raster_sources "$mode_directory" | while IFS= read -r source; do
      relative_path=${source#"$mode_directory/"}
      output_stem=${relative_path%.*}
      for width in $widths; do
        output=$destination/assets/images/${output_stem}-${width}w.webp
        mkdir -p "${output%/*}"
        render_image "$mode" "$source" "$width" "$output"
      done
    done
  done
}

copy_sources() {
  destination=$1
  copy_directory=$image_source_directory/copy

  find_files "$copy_directory" | while IFS= read -r source; do
    output=$destination/assets/images/${source#"$copy_directory/"}
    mkdir -p "${output%/*}"
    cp "$source" "$output"
  done
}

render_hero_portrait() {
  destination=$1
  source=$image_source_directory/xl/wide/hero/winding-road.jpg

  for dimensions in $hero_portrait_sizes; do
    width=${dimensions%:*}
    height=${dimensions#*:}
    output=$destination/assets/images/hero/winding-road-portrait-${width}w.webp
    mkdir -p "${output%/*}"
    magick "$source" \
      -auto-orient \
      -colorspace sRGB \
      -strip \
      -crop 1904x3384+2750+0 +repage \
      -resize "${width}x${height}^" \
      -gravity center \
      -extent "${width}x${height}" \
      -quality 82 \
      -define webp:method=6 \
      -define webp:thread-level=0 \
      "$output"
  done
}
subset_font() {
  source=$1
  output=$2

  node scripts/subset-font.mjs "$source" "$output"
}

render_all() {
  destination=$1

  mkdir -p "$destination/assets/fonts"
  for size in xl lg md; do
    render_size_class "$destination" "$size"
  done
  copy_sources "$destination"
  render_hero_portrait "$destination"
  subset_font "$mono_font_source_directory/JetBrainsMono-Light.ttf" "$destination/assets/fonts/jetbrains-mono-light.woff2"
  subset_font "$mono_font_source_directory/JetBrainsMono-LightItalic.ttf" "$destination/assets/fonts/jetbrains-mono-light-italic.woff2"
  subset_font "$mono_font_source_directory/JetBrainsMono-Regular.ttf" "$destination/assets/fonts/jetbrains-mono-regular.woff2"
  subset_font "$mono_font_source_directory/JetBrainsMono-Medium.ttf" "$destination/assets/fonts/jetbrains-mono-medium.woff2"
  subset_font "$mono_font_source_directory/JetBrainsMono-Bold.ttf" "$destination/assets/fonts/jetbrains-mono-bold.woff2"
  subset_font "$serif_font_source_directory/SourceSerif4-Regular.ttf" "$destination/assets/fonts/source-serif-4-regular.woff2"
  subset_font "$serif_font_source_directory/SourceSerif4-It.ttf" "$destination/assets/fonts/source-serif-4-italic.woff2"
  subset_font "$serif_font_source_directory/SourceSerif4-Bold.ttf" "$destination/assets/fonts/source-serif-4-bold.woff2"
  subset_font "$readable_font_source_directory/AtkinsonHyperlegibleNext-Regular.ttf" "$destination/assets/fonts/atkinson-hyperlegible-next-regular.woff2"
  subset_font "$readable_font_source_directory/AtkinsonHyperlegibleNext-Italic.ttf" "$destination/assets/fonts/atkinson-hyperlegible-next-italic.woff2"
  subset_font "$readable_font_source_directory/AtkinsonHyperlegibleNext-Bold.ttf" "$destination/assets/fonts/atkinson-hyperlegible-next-bold.woff2"
}

check_inventory() {
  actual=$(find assets/images/hero assets/images/video assets/images/news assets/images/desktop assets/images/workstations assets/images/patrons assets/fonts -type f | sort)
  expected=$(printf '%s\n' "$output_paths" | sed '/^$/d' | sort)
  [ "$actual" = "$expected" ] || fail 'Committed derivative inventory does not match scripts/build-assets.'
}

if [ "$mode" = check ]; then
  temporary_directory=$(mktemp -d)
  cleanup() {
    rm -rf "$temporary_directory"
  }
  trap cleanup EXIT HUP INT TERM

  check_inventory
  render_all "$temporary_directory"
  for output in $output_paths; do
    [ -f "$output" ] || fail "Missing committed derivative: $output"
    cmp -s "$temporary_directory/$output" "$output" || fail "Derivative differs from deterministic render: $output"
  done
  printf '%s\n' 'Asset derivatives are byte-identical.'
  exit 0
fi

render_all .
rm -f assets/images/news/radio-atlas-preview-1180w.webp
check_inventory
printf '%s\n' 'Rendered deterministic image and font derivatives.'
